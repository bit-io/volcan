    end
]

!! Geometria okna bez cieni/dekoracji klienta (windowGeometry()).
fun toplevel_window_x(h: Int) -> Int [
    end ffi_toplevel_window_x(h)
]

fun toplevel_window_y(h: Int) -> Int [
    end ffi_toplevel_window_y(h)
]

fun toplevel_window_width(h: Int) -> Int [
    end ffi_toplevel_window_width(h)
]

fun toplevel_window_height(h: Int) -> Int [
    end ffi_toplevel_window_height(h)
]

!! Fokus jak w typowym menedzerze okien: poprzednio aktywne okno traci stan
!! aktywny, to dostaje stan aktywny, fokus klawiatury i wedruje na wierzch.
fun toplevel_focus(h: Int) [
    if ffi_surface_valid(h) == 0 [
        end
    ]
    let prev = ffi_active_toplevel()
    if prev != 0 and prev != h [
        ffi_toplevel_set_activated(prev, 0)
    ]
    ffi_surface_raise(h)
    ffi_toplevel_set_activated(h, 1)
    ffi_keyboard_set_focus(h)
    end
]

fun surface_info(h: Int) -> SurfaceInfo [
    let role = ffi_surface_role(h)
    let title = ""
    let app_id = ""
    if role == ROLE_TOPLEVEL [
        title = text_read(0, h)
        app_id = text_read(1, h)
    ]
    end SurfaceInfo(h, role, ffi_surface_mapped(h) == 1, ffi_surface_x(h), ffi_surface_y(h), ffi_surface_width(h), ffi_surface_height(h), title, app_id)
]

!! Tryby dekoracji okna.
const DECORATION_CLIENT: Int = 0
const DECORATION_SERVER: Int = 1

!! Sugestia rozmiaru maksymalnego, jaki klient moze zajac (np. obszar uzytkowy).
