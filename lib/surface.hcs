!! Prosba o zmiane rozmiaru (klient odpowie nowym commit).
fun toplevel_resize(h: Int, width: Int, height: Int) [
    ffi_toplevel_configure_size(h, width, height)
    end
]

!! Prosi klienta o zamkniecie okna.
fun toplevel_close(h: Int) [
