include <ffi>
include <ffi_ext>
include <text>

const ROLE_NONE: Int = 0
const ROLE_SUBSURFACE: Int = 1
const ROLE_CURSOR: Int = 2
const ROLE_POPUP: Int = 3
const ROLE_DND_ICON: Int = 4
const ROLE_TOPLEVEL: Int = 5
const ROLE_SESSION_LOCK: Int = 6
const ROLE_LAYER: Int = 7

struct SurfaceInfo [
    handle: Int,
    role: Int,
    mapped: Bool,
    x: Int,
    y: Int,
    width: Int,
    height: Int,
    title: Str,
    app_id: Str
]

!! Wszystkie zyjace powierzchnie, w kolejnosci z LCompositor::surfaces().
fun surface_list() -> List<Int> [
    let out: List<Int> = []
    let n = ffi_surface_count()
    let i = 0
    while i < n [
        out.push(ffi_surface_at(i))
        i = i + 1
    ]
    end out
]

!! Tylko zmapowane okna toplevel (to, co zwykle chcesz ukladac).
fun toplevel_list() -> List<Int> [
    let out: List<Int> = []
    let n = ffi_surface_count()
    let i = 0
    while i < n [
        let h = ffi_surface_at(i)
        if ffi_surface_role(h) == ROLE_TOPLEVEL and ffi_surface_mapped(h) == 1 [
            out.push(h)
        ]
        i = i + 1
    ]
    end out
]

fun surface_valid(h: Int) -> Bool [
    end ffi_surface_valid(h) == 1
]

fun surface_role(h: Int) -> Int [
    end ffi_surface_role(h)
]

fun surface_mapped(h: Int) -> Bool [
    end ffi_surface_mapped(h) == 1
]

fun surface_x(h: Int) -> Int [
    end ffi_surface_x(h)
]

fun surface_y(h: Int) -> Int [
