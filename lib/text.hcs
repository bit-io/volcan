include <ffi>
include <ffi_ext>

!! Znak Unicode o kodzie `cp` jako Str (niepoprawny kod daje U+FFFD).
fun text_chr(cp: Int) -> Str [
    let out = ""
    native {Rust} [
        out = char::from_u32(cp as u32).unwrap_or('\u{FFFD}').to_string();
    ]
    end out
]

!! Dekoduje liste bajtow UTF-8 do Str.
fun text_from_utf8(bytes: List<Int>) -> Str [
    let out = ""
    let i = 0
    let n = bytes.len()
    while i < n [
        let b0 = bytes[i]
        let cp = 65533
        let step = 1
        if b0 < 128 [
            cp = b0
        ] elif b0 >= 194 and b0 <= 223 [
            if i + 1 < n and bytes[i + 1] >= 128 and bytes[i + 1] <= 191 [
                cp = (b0 - 192) * 64 + (bytes[i + 1] - 128)
                step = 2
            ]
        ] elif b0 >= 224 and b0 <= 239 [
            if i + 2 < n and bytes[i + 1] >= 128 and bytes[i + 1] <= 191 and bytes[i + 2] >= 128 and bytes[i + 2] <= 191 [
                cp = (b0 - 224) * 4096 + (bytes[i + 1] - 128) * 64 + (bytes[i + 2] - 128)
                step = 3
            ]
        ] elif b0 >= 240 and b0 <= 244 [
            if i + 3 < n and bytes[i + 1] >= 128 and bytes[i + 1] <= 191 and bytes[i + 2] >= 128 and bytes[i + 2] <= 191 and bytes[i + 3] >= 128 and bytes[i + 3] <= 191 [
                cp = (b0 - 240) * 262144 + (bytes[i + 1] - 128) * 4096 + (bytes[i + 2] - 128) * 64 + (bytes[i + 3] - 128)
                step = 4
            ]
        ]
        if cp >= 55296 and cp <= 57343 [
            cp = 65533
        ]
        if cp > 1114111 [
            cp = 65533
        ]
        out = out + text_chr(cp)
        i = i + step
    ]
    end out
]

!! Wpycha bajty UTF-8 napisu `s` do bufora shima o numerze `slot` (0 albo 1).
!! Bufor trzeba wczesniej wyczyscic (ffi_buf_clear).
fun text_push(slot: Int, s: Str) [
    native {Rust} [
        extern "C" { fn vcn_buf_push(slot: i64, byte: i64); }
        for b in s.bytes() {
            unsafe { vcn_buf_push(slot, b as i64) };
        }
    ]
    end
]

!! Czyta napis z pary funkcji (dlugosc, bajt) - wspolna czesc getterow
!! tytulu/app_id/nazwy wyjscia. `kind`: 0 tytul, 1 app_id, 2 nazwa wyjscia,
!! 3 nazwa seata, 4 zawartosc bufora 1 shima (wtedy `h` jest ignorowane).
fun text_read(kind: Int, h: Int) -> Str [
    let n = 0
    if kind == 0 [
        n = ffi_toplevel_title_len(h)
    ] elif kind == 1 [
        n = ffi_toplevel_app_id_len(h)
    ] elif kind == 2 [
        n = ffi_output_name_len(h)
    ] elif kind == 3 [
        n = ffi_seat_name_len()
    ] else [
        n = ffi_buf_len(1)
    ]
    let bytes: List<Int> = []
    let i = 0
    while i < n [
        let b = 0
        if kind == 0 [
            b = ffi_toplevel_title_char(h, i)
        ] elif kind == 1 [
            b = ffi_toplevel_app_id_char(h, i)
        ] elif kind == 2 [
            b = ffi_output_name_char(h, i)
        ] elif kind == 3 [
            b = ffi_seat_name_char(i)
        ] else [
            b = ffi_buf_at(1, i)
        ]
        if b >= 0 [
            bytes.push(b)
        ]
        i = i + 1
    ]
    end text_from_utf8(bytes)
]
