        // ---- gamma (np. filtr swiatla nocnego): skala kanalow w promilach, 1000 = bez zmian ----
        int64_t vcn_output_gamma_size(int64_t h) { if (!thread_ok()) return 0; LOutput *o = outp(h); return o ? (int64_t)o->gammaSize() : 0; }

        int64_t vcn_output_set_gamma_scale(int64_t h, int64_t r_permille, int64_t g_permille, int64_t b_permille)
        {
            if (!thread_ok()) return 0;
            LOutput *o = outp(h);
            if (!o || o->gammaSize() < 2)
                return 0;
            const size_t n = o->gammaSize();
            auto lut = RGammaLUT::Make(n);
            if (!lut)
                return 0;
            auto clampv = [](int64_t v) { return (UInt16)std::max<int64_t>(0, std::min<int64_t>(65535, v)); };
            for (size_t i = 0; i < n; i++)
            {
                int64_t base = (int64_t)i * 65535 / (int64_t)(n - 1);
                lut->red()[i] = clampv(base * r_permille / 1000);
                lut->green()[i] = clampv(base * g_permille / 1000);
                lut->blue()[i] = clampv(base * b_permille / 1000);
            }
            return o->setGammaLUT(lut) ? 1 : 0;
        }

