        // ---- v2: lancuchy C (dla H#, C, Rust itd.) ----
        // Zwracany wskaznik zyje do okolo 64 kolejnych wywolan funkcji *_c.
        static const char *vcn_ring(const std::string &s)
        {
            static std::string pool[64];
            static unsigned idx = 0;
            std::string &slot = pool[idx++ % 64u];
            slot = s;
            return slot.c_str();
        }

        int64_t vcn_setenv_c(const char *name, const char *value, int64_t overwrite)
        {
            if (!thread_ok()) return 0;
            if (!name || !value)
                return 0;
            return setenv(name, value, overwrite ? 1 : 0) == 0 ? 1 : 0;
        }

        int64_t vcn_spawn_c(const char *command)
        {
            if (!thread_ok()) return 0;
            if (!command)
                return 0;
            g_buf0 = command;
            return vcn_spawn();
        }

