        void vcn_overlay_clear(void) { if (!thread_ok()) return; g_style.overlays.clear(); g_style.texts.clear(); vcn_repaint_all(); }

        void vcn_overlay_clear_group(int64_t group)
        {
            if (!thread_ok()) return;
            g_style.overlays.erase(std::remove_if(g_style.overlays.begin(), g_style.overlays.end(), [&](const OverlayRect &o) { return o.group == group; }), g_style.overlays.end());
            g_style.texts.erase(std::remove_if(g_style.texts.begin(), g_style.texts.end(), [&](const OverlayText &o) { return o.group == group; }), g_style.texts.end());
            vcn_repaint_all();
        }

        int64_t vcn_overlay_count(void) { if (!thread_ok()) return 0; return (int64_t)(g_style.overlays.size() + g_style.texts.size()); }

        int64_t vcn_overlay_rect_g(int64_t group, int64_t x, int64_t y, int64_t w, int64_t h, int64_t argb)
        {
            if (!thread_ok()) return 0;
            if (g_style.overlays.size() >= 4096)
            {
                set_error(VCN_E_STATE, "za duzo nakladek");
                return -1;
            }
            g_style.overlays.push_back(OverlayRect { x, y, w, h, (uint32_t)argb, group });
            vcn_repaint_all();
            return (int64_t)g_style.overlays.size() - 1;
        }

