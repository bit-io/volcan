        // Modyfikatory z stanu xkb: 1 shift, 2 ctrl, 4 alt, 8 super.
        int64_t vcn_keyboard_mods(void)
        {
            if (!thread_ok()) return 0;
            if (!g_comp)
                return 0;
            LKeyboard *k = g_comp->seat()->keyboard();
            int64_t m = 0;
            if (k->isModActive(XKB_MOD_NAME_SHIFT, XKB_STATE_MODS_EFFECTIVE))
                m |= 1;
            if (k->isModActive(XKB_MOD_NAME_CTRL, XKB_STATE_MODS_EFFECTIVE))
                m |= 2;
            if (k->isModActive(XKB_MOD_NAME_ALT, XKB_STATE_MODS_EFFECTIVE))
                m |= 4;
            if (k->isModActive(XKB_MOD_NAME_LOGO, XKB_STATE_MODS_EFFECTIVE))
                m |= 8;
            return m;
        }

