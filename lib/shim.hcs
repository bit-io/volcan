        int64_t vcn_output_current_mode(int64_t h)
        {
            if (!thread_ok()) return 0;
            LOutput *o = outp(h);
            if (!o)
                return -1;
            auto cur = o->currentMode();
            for (size_t i = 0; i < o->modes().size(); i++)
                if (o->modes().at(i) == cur)
                    return (int64_t)i;
            return -1;
        }

        int64_t vcn_output_set_mode(int64_t h, int64_t i)
        {
            if (!thread_ok()) return 0;
            LOutput *o = outp(h);
            auto m = vcn_mode(h, i);
            if (!o || !m)
                return 0;
            return o->setMode(m) ? 1 : 0;
        }

