        // ---- layer-shell: warstwa 0 tlo, 1 dol, 3 gora, 4 nakladka; kotwice jak EDGE_* (1 gora, 2 dol, 4 lewa, 8 prawa) ----
        static LLayerRole *lay(int64_t h) { LSurface *s = surf(h); return s ? s->layerRole() : nullptr; }

        int64_t vcn_layer_layer(int64_t h) { if (!thread_ok()) return 0; LLayerRole *l = lay(h); return l ? (int64_t)l->layer() : -1; }

        int64_t vcn_layer_anchor(int64_t h)
        {
            if (!thread_ok()) return 0;
            LLayerRole *l = lay(h);
            if (!l)
                return 0;
            int64_t m = 0;
            if (l->anchor().has(CZEdgeTop))
                m |= 1;
            if (l->anchor().has(CZEdgeBottom))
                m |= 2;
            if (l->anchor().has(CZEdgeLeft))
                m |= 4;
            if (l->anchor().has(CZEdgeRight))
                m |= 8;
            return m;
        }

        int64_t vcn_layer_exclusive_zone(int64_t h) { if (!thread_ok()) return 0; LLayerRole *l = lay(h); return l ? (int64_t)l->exclusiveZoneSize() : 0; }
