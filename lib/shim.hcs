        // END-PROTOGEN

        // BEGIN-SCREENCOPY (silnik ext-image-copy-capture-v1: tylko libwayland + biblioteka standardowa, testowany osobno z prawdziwym klientem)
        // Zrodlo przechwytu (ext_image_capture_source_v1) tworzy Louvre; ta czesc dodaje manager kopiowania klatek.
        // Dostawca (ScProvider) podaje trzy rzeczy: do jakiego wyjscia nalezy zrodlo, jaki ma rozmiar i jak odczytac piksele.
        // Formaty bufora to ARGB8888 i XRGB8888: libwayland reklamuje je zawsze (wl_display_init_shm), wiec kazdy klient je utworzy.
        struct ScProvider
        {
            int64_t (*resolve)(struct wl_resource *source, void *ud) = nullptr;
            bool (*size)(int64_t out, int *w, int *h, void *ud) = nullptr;
            bool (*read)(int64_t out, uint8_t *dst, int stride, int w, int h, uint32_t shm_format, void *ud) = nullptr;
            // tylko dla wlr-screencopy: wl_output klienta -> wyjscie, oraz skala wyjscia w promilach (1000 = 1.0)
            int64_t (*resolve_output)(struct wl_resource *wl_output, void *ud) = nullptr;
            int64_t (*scale_permille)(int64_t out, void *ud) = nullptr;
            void *ud = nullptr;
        };

        struct ScFrame;
        struct ScSession
        {
            struct wl_resource *res = nullptr;
            int64_t out = 0;
            int w = 0, h = 0;
            bool stopped = false;
            bool delivered = false;
            ScFrame *frame = nullptr;
        };

        struct ScFrame
        {
            struct wl_resource *res = nullptr;
            ScSession *sess = nullptr;
            struct wl_resource *buffer = nullptr;
            struct wl_listener buf_listener;
            bool listening = false;
            bool captured = false;
            bool done = false;
        };

        static ScProvider g_sc_prov;
        static struct wl_global *g_sc_global = nullptr;
        static std::vector<ScSession *> g_sc_sessions;
        static int64_t g_sc_frames_ok = 0;
        static int64_t g_sc_frames_failed = 0;

        static void sc_frame_fail(ScFrame *f, uint32_t reason)
        {
            if (!f || f->done)
                return;
            f->done = true;
            g_sc_frames_failed++;
            vcn_ext_image_copy_capture_frame_v1_send_failed(f->res, reason);
        }

        static void sc_buffer_gone(struct wl_listener *l, void *)
        {
            ScFrame *f = wl_container_of(l, f, buf_listener);
            f->buffer = nullptr;
            f->listening = false;
            wl_list_remove(&l->link);
        }

        static void sc_frame_unlisten(ScFrame *f)
        {
            if (f->listening)
            {
                wl_list_remove(&f->buf_listener.link);
                f->listening = false;
            }
        }

        static void sc_session_send_config(ScSession *s)
        {
            vcn_ext_image_copy_capture_session_v1_send_buffer_size(s->res, (uint32_t)s->w, (uint32_t)s->h);
            vcn_ext_image_copy_capture_session_v1_send_shm_format(s->res, WL_SHM_FORMAT_ARGB8888);
            vcn_ext_image_copy_capture_session_v1_send_shm_format(s->res, WL_SHM_FORMAT_XRGB8888);
            vcn_ext_image_copy_capture_session_v1_send_done(s->res);
        }

        static void sc_session_stop(ScSession *s)
        {
            if (s->stopped)
                return;
            s->stopped = true;
            if (s->frame && s->frame->captured)
                sc_frame_fail(s->frame, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
            vcn_ext_image_copy_capture_session_v1_send_stopped(s->res);
        }

        // Wypelnia bufor klienta klatka wyjscia i wysyla ready; blad -> failed.
        static void sc_frame_complete(ScFrame *f)
        {
            ScSession *s = f->sess;
            if (!s || s->stopped)
            {
                sc_frame_fail(f, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
                return;
            }
            int w = 0, h = 0;
            if (!g_sc_prov.size || !g_sc_prov.size(s->out, &w, &h, g_sc_prov.ud))
            {
                sc_session_stop(s);
                return;
            }
            if (w != s->w || h != s->h)
            {
                // rozmiar wyjscia sie zmienil: nowe parametry bufora, ta klatka sie nie udaje
                s->w = w;
                s->h = h;
                sc_session_send_config(s);
                sc_frame_fail(f, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS);
                return;
            }
            struct wl_shm_buffer *shm = f->buffer ? wl_shm_buffer_get(f->buffer) : nullptr;
            const uint32_t fmt = shm ? wl_shm_buffer_get_format(shm) : 0;
            if (!shm || wl_shm_buffer_get_width(shm) != w || wl_shm_buffer_get_height(shm) != h ||
                wl_shm_buffer_get_stride(shm) < w * 4 || (fmt != WL_SHM_FORMAT_ARGB8888 && fmt != WL_SHM_FORMAT_XRGB8888))
            {
                sc_frame_fail(f, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_BUFFER_CONSTRAINTS);
                return;
            }
            const int stride = wl_shm_buffer_get_stride(shm);
            bool ok = false;
            wl_shm_buffer_begin_access(shm);
            uint8_t *data = (uint8_t *)wl_shm_buffer_get_data(shm);
            if (data && g_sc_prov.read && g_sc_prov.read(s->out, data, stride, w, h, fmt, g_sc_prov.ud))
            {
                for (int y = 0; y < h; y++)
                    for (int x = 0; x < w; x++)
                        data[(size_t)y * (size_t)stride + (size_t)x * 4u + 3u] = 255;
                ok = true;
            }
            wl_shm_buffer_end_access(shm);
            if (!ok)
            {
                sc_frame_fail(f, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_UNKNOWN);
                return;
            }
            struct timespec ts {};
            clock_gettime(CLOCK_MONOTONIC, &ts);
            const uint64_t sec = (uint64_t)ts.tv_sec;
            vcn_ext_image_copy_capture_frame_v1_send_transform(f->res, 0);
            vcn_ext_image_copy_capture_frame_v1_send_damage(f->res, 0, 0, w, h);
            vcn_ext_image_copy_capture_frame_v1_send_presentation_time(f->res, (uint32_t)(sec >> 32), (uint32_t)(sec & 0xffffffffu), (uint32_t)ts.tv_nsec);
            vcn_ext_image_copy_capture_frame_v1_send_ready(f->res);
            f->done = true;
            s->delivered = true;
            g_sc_frames_ok++;
        }

        static void sc_destroy_request(struct wl_client *, struct wl_resource *r) { wl_resource_destroy(r); }

        static void sc_frame_resource_destroy(struct wl_resource *r)
        {
            ScFrame *f = (ScFrame *)wl_resource_get_user_data(r);
            if (!f)
                return;
            sc_frame_unlisten(f);
            if (f->sess && f->sess->frame == f)
                f->sess->frame = nullptr;
            delete f;
        }

        static void sc_frame_attach_buffer(struct wl_client *, struct wl_resource *r, struct wl_resource *buffer)
        {
            ScFrame *f = (ScFrame *)wl_resource_get_user_data(r);
            if (f->captured)
            {
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED, "bufor po capture");
                return;
            }
            sc_frame_unlisten(f);
            f->buffer = buffer;
            f->buf_listener.notify = sc_buffer_gone;
            wl_resource_add_destroy_listener(buffer, &f->buf_listener);
            f->listening = true;
        }

        static void sc_frame_damage_buffer(struct wl_client *, struct wl_resource *r, int32_t x, int32_t y, int32_t w, int32_t h)
        {
            ScFrame *f = (ScFrame *)wl_resource_get_user_data(r);
            if (f->captured)
            {
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED, "uszkodzenie po capture");
                return;
            }
            if (x < 0 || y < 0 || w <= 0 || h <= 0)
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_INVALID_BUFFER_DAMAGE, "niepoprawne uszkodzenie bufora");
        }

        static void sc_frame_capture(struct wl_client *, struct wl_resource *r)
        {
            ScFrame *f = (ScFrame *)wl_resource_get_user_data(r);
            if (f->captured)
            {
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_ALREADY_CAPTURED, "capture wywolane dwa razy");
                return;
            }
            if (!f->buffer)
            {
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_ERROR_NO_BUFFER, "capture bez bufora");
                return;
            }
            f->captured = true;
            if (!f->sess || f->sess->stopped)
            {
                sc_frame_fail(f, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
                return;
            }
            if (!f->sess->delivered)
                sc_frame_complete(f);      // pierwsza klatka sesji: od razu, bez czekania na uszkodzenie
        }

        static const struct vcn_ext_image_copy_capture_frame_v1_interface sc_frame_impl = {
            sc_destroy_request, sc_frame_attach_buffer, sc_frame_damage_buffer, sc_frame_capture
        };

        static void sc_session_resource_destroy(struct wl_resource *r)
        {
            ScSession *s = (ScSession *)wl_resource_get_user_data(r);
            if (!s)
                return;
            if (s->frame)
            {
                if (s->frame->captured)
                    sc_frame_fail(s->frame, vcn_EXT_IMAGE_COPY_CAPTURE_FRAME_V1_FAILURE_REASON_STOPPED);
                s->frame->sess = nullptr;
                s->frame = nullptr;
            }
            g_sc_sessions.erase(std::remove(g_sc_sessions.begin(), g_sc_sessions.end(), s), g_sc_sessions.end());
            delete s;
        }

        static void sc_session_create_frame(struct wl_client *client, struct wl_resource *r, uint32_t id)
        {
            ScSession *s = (ScSession *)wl_resource_get_user_data(r);
            if (s->frame)
            {
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_SESSION_V1_ERROR_DUPLICATE_FRAME, "poprzednia klatka nie jest skonczona");
                return;
            }
            ScFrame *f = new ScFrame();
            f->res = wl_resource_create(client, &vcn_ext_image_copy_capture_frame_v1_interface, wl_resource_get_version(r), id);
            if (!f->res)
            {
                delete f;
                wl_client_post_no_memory(client);
                return;
            }
            wl_resource_set_implementation(f->res, &sc_frame_impl, f, sc_frame_resource_destroy);
            f->sess = s;
            s->frame = f;
        }

        static const struct vcn_ext_image_copy_capture_session_v1_interface sc_session_impl = { sc_session_create_frame, sc_destroy_request };

        static ScSession *sc_session_make(struct wl_client *client, struct wl_resource *mgr, uint32_t id, int64_t out)
        {
            ScSession *s = new ScSession();
            s->out = out;
            s->res = wl_resource_create(client, &vcn_ext_image_copy_capture_session_v1_interface, wl_resource_get_version(mgr), id);
            if (!s->res)
            {
                delete s;
                wl_client_post_no_memory(client);
                return nullptr;
            }
            wl_resource_set_implementation(s->res, &sc_session_impl, s, sc_session_resource_destroy);
            g_sc_sessions.push_back(s);
            int w = 0, h = 0;
            if (!out || !g_sc_prov.size || !g_sc_prov.size(out, &w, &h, g_sc_prov.ud))
            {
                sc_session_stop(s);
                return s;
            }
            s->w = w;
            s->h = h;
            sc_session_send_config(s);
            return s;
        }

        static void sc_manager_create_session(struct wl_client *client, struct wl_resource *r, uint32_t id, struct wl_resource *source, uint32_t options)
        {
            if (options & ~(uint32_t)vcn_EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS)
            {
                wl_resource_post_error(r, vcn_EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_ERROR_INVALID_OPTION, "nieznane opcje %u", options);
                return;
            }
            const int64_t out = g_sc_prov.resolve ? g_sc_prov.resolve(source, g_sc_prov.ud) : 0;
            sc_session_make(client, r, id, out);
        }

        static void sc_cursor_get_session(struct wl_client *client, struct wl_resource *r, uint32_t id)
        {
            ScSession *s = sc_session_make(client, r, id, 0);     // kursora nie przechwytujemy: sesja konczy sie od razu
            (void)s;
        }

        static const struct vcn_ext_image_copy_capture_cursor_session_v1_interface sc_cursor_impl = { sc_destroy_request, sc_cursor_get_session };

        static void sc_manager_create_cursor_session(struct wl_client *client, struct wl_resource *r, uint32_t id, struct wl_resource *, struct wl_resource *)
        {
            struct wl_resource *c = wl_resource_create(client, &vcn_ext_image_copy_capture_cursor_session_v1_interface, wl_resource_get_version(r), id);
            if (!c)
            {
                wl_client_post_no_memory(client);
                return;
            }
            wl_resource_set_implementation(c, &sc_cursor_impl, nullptr, nullptr);
        }

        static const struct vcn_ext_image_copy_capture_manager_v1_interface sc_manager_impl = {
            sc_manager_create_session, sc_manager_create_cursor_session, sc_destroy_request
        };

        static void sc_bind(struct wl_client *client, void *, uint32_t version, uint32_t id)
        {
            struct wl_resource *r = wl_resource_create(client, &vcn_ext_image_copy_capture_manager_v1_interface, version > 1 ? 1 : (int)version, id);
            if (!r)
            {
                wl_client_post_no_memory(client);
                return;
            }
            wl_resource_set_implementation(r, &sc_manager_impl, nullptr, nullptr);
        }


        // ---- wlr-screencopy-unstable-v1 (wersja 3, tylko wl_shm): grim, wf-recorder, xdg-desktop-portal-wlr ----
        struct WFrame
        {
            struct wl_resource *res = nullptr;
            int64_t out = 0;
            int ow = 0, oh = 0;          // rozmiar wyjscia w chwili utworzenia klatki (piksele)
            int x = 0, y = 0, w = 0, h = 0;   // wycinek w pikselach bufora wyjscia
            struct wl_resource *buffer = nullptr;
            struct wl_listener buf_listener;
            bool listening = false;
            bool copied = false;
            bool with_damage = false;
            bool done = false;
        };

        static struct wl_global *g_wlr_global = nullptr;
        static std::vector<WFrame *> g_wlr_frames;

        static void wlr_unlisten(WFrame *f)
        {
            if (f->listening)
            {
                wl_list_remove(&f->buf_listener.link);
                f->listening = false;
            }
        }

        static void wlr_buffer_gone(struct wl_listener *l, void *)
        {
            WFrame *f = wl_container_of(l, f, buf_listener);
            f->buffer = nullptr;
            f->listening = false;
            wl_list_remove(&l->link);
        }

        static void wlr_fail(WFrame *f)
        {
            if (f->done)
                return;
            f->done = true;
            g_sc_frames_failed++;
            vcn_zwlr_screencopy_frame_v1_send_failed(f->res);
        }

        static void wlr_complete(WFrame *f)
        {
            int ow = 0, oh = 0;
            if (!g_sc_prov.size || !g_sc_prov.size(f->out, &ow, &oh, g_sc_prov.ud) || ow != f->ow || oh != f->oh)
            {
                wlr_fail(f);
                return;
            }
            struct wl_shm_buffer *shm = f->buffer ? wl_shm_buffer_get(f->buffer) : nullptr;
            const uint32_t fmt = shm ? wl_shm_buffer_get_format(shm) : 0;
            if (!shm || wl_shm_buffer_get_width(shm) != f->w || wl_shm_buffer_get_height(shm) != f->h)
            {
                wlr_fail(f);
                return;
            }
            const int stride = wl_shm_buffer_get_stride(shm);
            bool ok = false;
            wl_shm_buffer_begin_access(shm);
            uint8_t *data = (uint8_t *)wl_shm_buffer_get_data(shm);
            if (data && g_sc_prov.read)
            {
                if (f->x == 0 && f->y == 0 && f->w == ow && f->h == oh)
                    ok = g_sc_prov.read(f->out, data, stride, ow, oh, fmt, g_sc_prov.ud);
                else
                {
                    std::vector<uint8_t> tmp((size_t)ow * (size_t)oh * 4u);
                    ok = g_sc_prov.read(f->out, tmp.data(), ow * 4, ow, oh, fmt, g_sc_prov.ud);
                    if (ok)
                        for (int row = 0; row < f->h; row++)
                            std::memcpy(data + (size_t)row * (size_t)stride, tmp.data() + ((size_t)(f->y + row) * (size_t)ow + (size_t)f->x) * 4u, (size_t)f->w * 4u);
                }
                if (ok)
                    for (int row = 0; row < f->h; row++)
                        for (int col = 0; col < f->w; col++)
                            data[(size_t)row * (size_t)stride + (size_t)col * 4u + 3u] = 255;
            }
            wl_shm_buffer_end_access(shm);
            if (!ok)
            {
                wlr_fail(f);
                return;
            }
            struct timespec ts {};
            clock_gettime(CLOCK_MONOTONIC, &ts);
            const uint64_t sec = (uint64_t)ts.tv_sec;
            vcn_zwlr_screencopy_frame_v1_send_flags(f->res, 0);
            if (f->with_damage)
                vcn_zwlr_screencopy_frame_v1_send_damage(f->res, 0, 0, (uint32_t)f->w, (uint32_t)f->h);
            vcn_zwlr_screencopy_frame_v1_send_ready(f->res, (uint32_t)(sec >> 32), (uint32_t)(sec & 0xffffffffu), (uint32_t)ts.tv_nsec);
            f->done = true;
            g_sc_frames_ok++;
        }

        static void wlr_frame_copy_common(struct wl_resource *r, struct wl_resource *buffer, bool with_damage)
        {
            WFrame *f = (WFrame *)wl_resource_get_user_data(r);
            if (f->copied)
            {
                wl_resource_post_error(r, vcn_ZWLR_SCREENCOPY_FRAME_V1_ERROR_ALREADY_USED, "klatka juz uzyta");
                return;
            }
            struct wl_shm_buffer *shm = wl_shm_buffer_get(buffer);
            if (!shm || wl_shm_buffer_get_width(shm) != f->w || wl_shm_buffer_get_height(shm) != f->h ||
                wl_shm_buffer_get_stride(shm) < f->w * 4 ||
                (wl_shm_buffer_get_format(shm) != WL_SHM_FORMAT_ARGB8888 && wl_shm_buffer_get_format(shm) != WL_SHM_FORMAT_XRGB8888))
            {
                wl_resource_post_error(r, vcn_ZWLR_SCREENCOPY_FRAME_V1_ERROR_INVALID_BUFFER, "zly rozmiar, stride albo format bufora");
                return;
            }
            f->copied = true;
            f->with_damage = with_damage;
            f->buffer = buffer;
            f->buf_listener.notify = wlr_buffer_gone;
            wl_resource_add_destroy_listener(buffer, &f->buf_listener);
            f->listening = true;
            if (!with_damage)
                wlr_complete(f);          // zwykle copy: od razu; copy_with_damage czeka na odmalowanie wyjscia
        }

        static void wlr_frame_copy(struct wl_client *, struct wl_resource *r, struct wl_resource *buffer) { wlr_frame_copy_common(r, buffer, false); }
        static void wlr_frame_copy_with_damage(struct wl_client *, struct wl_resource *r, struct wl_resource *buffer) { wlr_frame_copy_common(r, buffer, true); }

        static void wlr_frame_resource_destroy(struct wl_resource *r)
        {
            WFrame *f = (WFrame *)wl_resource_get_user_data(r);
            if (!f)
                return;
            wlr_unlisten(f);
            g_wlr_frames.erase(std::remove(g_wlr_frames.begin(), g_wlr_frames.end(), f), g_wlr_frames.end());
            delete f;
        }

        static const struct vcn_zwlr_screencopy_frame_v1_interface wlr_frame_impl = { wlr_frame_copy, sc_destroy_request, wlr_frame_copy_with_damage };

        static void wlr_capture(struct wl_client *client, struct wl_resource *mgr, uint32_t id, struct wl_resource *output, bool region, int32_t x, int32_t y, int32_t w, int32_t h)
        {
            WFrame *f = new WFrame();
            f->res = wl_resource_create(client, &vcn_zwlr_screencopy_frame_v1_interface, wl_resource_get_version(mgr), id);
            if (!f->res)
            {
                delete f;
                wl_client_post_no_memory(client);
                return;
            }
            wl_resource_set_implementation(f->res, &wlr_frame_impl, f, wlr_frame_resource_destroy);
            g_wlr_frames.push_back(f);
            f->out = g_sc_prov.resolve_output ? g_sc_prov.resolve_output(output, g_sc_prov.ud) : 0;
            int ow = 0, oh = 0;
            if (!f->out || !g_sc_prov.size || !g_sc_prov.size(f->out, &ow, &oh, g_sc_prov.ud))
            {
                wlr_fail(f);
                return;
            }
            f->ow = ow;
            f->oh = oh;
            f->x = 0; f->y = 0; f->w = ow; f->h = oh;
            if (region)
            {
                const int64_t k = g_sc_prov.scale_permille ? g_sc_prov.scale_permille(f->out, g_sc_prov.ud) : 1000;
                int64_t x0 = (int64_t)x * k / 1000, y0 = (int64_t)y * k / 1000;
                int64_t x1 = ((int64_t)x + w) * k / 1000, y1 = ((int64_t)y + h) * k / 1000;
                x0 = std::max<int64_t>(0, x0); y0 = std::max<int64_t>(0, y0);
                x1 = std::min<int64_t>(ow, x1); y1 = std::min<int64_t>(oh, y1);
                if (w <= 0 || h <= 0 || x1 <= x0 || y1 <= y0)
                {
                    wlr_fail(f);
                    return;
                }
                f->x = (int)x0; f->y = (int)y0; f->w = (int)(x1 - x0); f->h = (int)(y1 - y0);
            }
            const uint32_t stride = (uint32_t)f->w * 4u;
            vcn_zwlr_screencopy_frame_v1_send_buffer(f->res, WL_SHM_FORMAT_ARGB8888, (uint32_t)f->w, (uint32_t)f->h, stride);
            if (wl_resource_get_version(f->res) >= 3)
            {
                vcn_zwlr_screencopy_frame_v1_send_buffer(f->res, WL_SHM_FORMAT_XRGB8888, (uint32_t)f->w, (uint32_t)f->h, stride);
                vcn_zwlr_screencopy_frame_v1_send_buffer_done(f->res);
            }
        }

        static void wlr_manager_capture_output(struct wl_client *client, struct wl_resource *r, uint32_t id, int32_t, struct wl_resource *output)
        {
            wlr_capture(client, r, id, output, false, 0, 0, 0, 0);
        }

        static void wlr_manager_capture_output_region(struct wl_client *client, struct wl_resource *r, uint32_t id, int32_t, struct wl_resource *output, int32_t x, int32_t y, int32_t w, int32_t h)
        {
            wlr_capture(client, r, id, output, true, x, y, w, h);
        }

        static const struct vcn_zwlr_screencopy_manager_v1_interface wlr_manager_impl = { wlr_manager_capture_output, wlr_manager_capture_output_region, sc_destroy_request };

        static void wlr_bind(struct wl_client *client, void *, uint32_t version, uint32_t id)
        {
            struct wl_resource *r = wl_resource_create(client, &vcn_zwlr_screencopy_manager_v1_interface, version > 3 ? 3 : (int)version, id);
            if (!r)
            {
                wl_client_post_no_memory(client);
                return;
            }
            wl_resource_set_implementation(r, &wlr_manager_impl, nullptr, nullptr);
        }

        static void wlr_output_painted(int64_t out)
        {
            const std::vector<WFrame *> copy = g_wlr_frames;
            for (WFrame *f : copy)
                if (f->out == out && f->copied && f->with_damage && !f->done)
                    wlr_complete(f);
        }

        static void wlr_output_removed(int64_t out)
        {
            const std::vector<WFrame *> copy = g_wlr_frames;
            for (WFrame *f : copy)
                if (f->out == out)
                    wlr_fail(f);
        }

        static bool vcn_sc_init(struct wl_display *d, const ScProvider &p)
        {
            if (g_sc_global || !d)
                return false;
            g_sc_prov = p;
            g_sc_global = wl_global_create(d, &vcn_ext_image_copy_capture_manager_v1_interface, 1, nullptr, sc_bind);
            if (g_sc_global && p.resolve_output)
                g_wlr_global = wl_global_create(d, &vcn_zwlr_screencopy_manager_v1_interface, 3, nullptr, wlr_bind);
            return g_sc_global != nullptr;
        }

        static void vcn_sc_shutdown(void)
        {
            if (g_wlr_global)
            {
                wl_global_destroy(g_wlr_global);
                g_wlr_global = nullptr;
            }
            if (g_sc_global)
            {
                wl_global_destroy(g_sc_global);
                g_sc_global = nullptr;
            }
        }

        // Wolane po zaprezentowaniu klatki wyjscia: konczy oczekujace klatki sesji tego wyjscia.
        static void vcn_sc_output_painted(int64_t out)
        {
            wlr_output_painted(out);
            if (g_sc_sessions.empty())
                return;
            const std::vector<ScSession *> copy = g_sc_sessions;
            for (ScSession *s : copy)
            {
                if (s->out == out && s->frame && s->frame->captured && !s->frame->done)
                    sc_frame_complete(s->frame);
            }
        }

        // Wolane, gdy wyjscie znika: sesje sie koncza (stopped), oczekujace klatki dostaja failed.
        static void vcn_sc_output_removed(int64_t out)
        {
            wlr_output_removed(out);
            const std::vector<ScSession *> copy = g_sc_sessions;
            for (ScSession *s : copy)
            {
                if (s->out == out)
                    sc_session_stop(s);
            }
        }

        static int64_t vcn_sc_session_count(void) { return (int64_t)g_sc_sessions.size(); }
        static int64_t vcn_sc_frames_ok(void) { return g_sc_frames_ok; }
        static int64_t vcn_sc_frames_failed(void) { return g_sc_frames_failed; }
        // END-SCREENCOPY

        class VOutput : public LOutput
        {
        public:
            VOutput(const void *params) noexcept : LOutput(params) {}

            // Klatka zaprezentowana (watek glowny): konczy oczekujace klatki screencopy tego wyjscia.
            void presentationEvent(const CZPresentationEvent &e) noexcept override
            {
                LOutput::presentationEvent(e);
                vcn_sc_output_painted(H(this));
            }

            void paintGL() override
            {
                const bool blank = g_blank.count(H(this)) != 0;
                LOutput *mirror = nullptr;
                auto mit = g_mirror.find(H(this));
                if (mit != g_mirror.end())
                {
                    for (LOutput *o : compositor()->outputs())
                        if (H(o) == mit->second)
                            mirror = o;
                }
                if (!g_style.enabled && !blank && !mirror)
                {
                    LOutput::paintGL();
                    return;
                }

                auto surface { RSurface::WrapImage(image()) };
                const SkRect viewport = SkRect::Make(mirror ? mirror->rect() : rect());
                SkRect dstr = SkRect::Make(image()->size());
                if (mirror)
                {
                    const SkScalar k = std::min(dstr.width() / viewport.width(), dstr.height() / viewport.height());
                    const SkScalar w = viewport.width() * k, h = viewport.height() * k;
                    dstr = SkRect::MakeXYWH((dstr.width() - w) / 2.f, (dstr.height() - h) / 2.f, w, h);
                }
                surface->setGeometry({ .viewport = viewport, .dst = dstr, .transform = transform() });

                auto pass { surface->beginPass(RPassCap_SkCanvas) };
                SkCanvas *c { pass->getCanvas() };
                if (blank)
                {
                    c->clear(SK_ColorBLACK);
                    return;
                }
                c->clear(mirror ? SK_ColorBLACK : (SkColor)g_style.background);
                v_draw_wallpaper(c, viewport);

                if (sessionLockManager()->state() != LSessionLockManager::Unlocked)
                {
                    if (sessionLockRole())
                        v_draw_tree(c, sessionLockRole()->surface());
                    return;
                }

                if (seat()->dnd()->icon())
                    seat()->dnd()->icon()->surface()->raise();

                for (const auto &layer : compositor()->layers())
                {
                    for (LSurface *s : layer)
                    {
                        if (s->parent())
                            continue;
                        if (s->cursorRole())
                        {
                            s->requestNextFrame();
                            continue;
                        }
                        v_draw_tree(c, s);
                    }
                }

                for (const OverlayRect &o : g_style.overlays)
                {
                    SkPaint p;
                    p.setColor((SkColor)o.argb);
                    c->drawRect(SkRect::MakeXYWH((SkScalar)o.x, (SkScalar)o.y, (SkScalar)o.w, (SkScalar)o.h), p);
                }
                for (const OverlayText &o : g_style.texts)
                    v_text(c, o.text, (SkScalar)o.x, (SkScalar)o.y, o.size, o.argb, 1.0);
            }
        };

        class VCompositor : public LCompositor
        {
        public:
            LFactoryObject *createObjectRequest(LFactoryObject::Type type, const void *params) override
            {
                switch (type)
                {
                case LFactoryObject::Type::LSurface:
                    return new VSurface(params);
                case LFactoryObject::Type::LToplevelRole:
                    return new VToplevel(params);
                case LFactoryObject::Type::LSeat:
                    return new VSeat(params);
                case LFactoryObject::Type::LPointer:
                    return new VPointer(params);
                case LFactoryObject::Type::LKeyboard:
                    return new VKeyboard(params);
                case LFactoryObject::Type::LPopupRole:
                    return new VPopup(params);
                case LFactoryObject::Type::LLayerRole:
                    return new VLayer(params);
                case LFactoryObject::Type::LTouch:
                    return new VTouch(params);
                case LFactoryObject::Type::LClipboard:
                    return new VClipboard(params);
                case LFactoryObject::Type::LDND:
                    return new VDND(params);
                case LFactoryObject::Type::LSessionLockManager:
                    return new VSessionLock(params);
                case LFactoryObject::Type::LOutput:
                    return new VOutput(params);
                default:
                    return nullptr;
                }
            }

            void onAnticipatedObjectDestruction(LFactoryObject *object) override
            {
                if (object->factoryObjectType() == LFactoryObject::Type::LSurface)
                    push(2, H(static_cast<LSurface *>(object)));
            }
        };

        VCompositor *g_comp = nullptr;

        // ---- walidacja uchwytow: uchwyt musi nalezec do zywego obiektu ----

        LSurface *surf_quiet(int64_t h)
        {
            if (!g_comp || h == 0)
                return nullptr;
            for (LSurface *s : g_comp->surfaces())
                if (H(s) == h)
                    return s;
            return nullptr;
        }

        LSurface *surf(int64_t h)
        {
            LSurface *s = surf_quiet(h);
            if (!s && h != 0)
                set_error(VCN_E_HANDLE, "nieprawidlowy uchwyt powierzchni");
            return s;
        }

        LToplevelRole *top(int64_t h)
        {
            LSurface *s = surf(h);
            return s ? s->toplevel() : nullptr;
        }

        LOutput *outp_quiet(int64_t h)
        {
            if (!g_comp || h == 0)
                return nullptr;
            for (LOutput *o : g_comp->outputs())
                if (H(o) == h)
                    return o;
            return nullptr;
        }

        LOutput *outp(int64_t h)
        {
            LOutput *o = outp_quiet(h);
            if (!o && h != 0)
                set_error(VCN_E_HANDLE, "nieprawidlowy uchwyt wyjscia");
            return o;
        }

        int64_t str_len(const std::string &s)
        {
            return (int64_t)s.size();
        }

        int64_t str_at(const std::string &s, int64_t i)
        {
            if (i < 0 || i >= (int64_t)s.size())
                return -1;
            return (int64_t)(unsigned char)s.at((size_t)i);
        }
        }

        extern "C"
        {
        // ---- cykl zycia ----
        int64_t vcn_abi_version(void) { return 1; }
        int64_t vcn_launcher_start(void) { if (!thread_ok()) return 0; return (int64_t)LLauncher::startDaemon(); }

        int64_t vcn_init(void)
        {
            if (!thread_ok()) return 0;
            if (!g_comp)
                g_comp = new VCompositor();
            if (!g_comp)
                g_last_error = "nie udalo sie utworzyc LCompositor";
            return g_comp ? 1 : 0;
        }


        // ---- screencopy: dostawca silnika SCREENCOPY oparty na Louvre ----
        static int64_t sc_prov_resolve(struct wl_resource *source, void *)
        {
            if (!source)
                return 0;
            LResource *lr = static_cast<LResource *>(wl_resource_get_user_data(source));
            auto *cs = dynamic_cast<CZ::Protocols::ImageCaptureSource::RImageCaptureSource *>(lr);
            if (!cs || cs->type() != LImageCaptureSourceType::Output)
                return 0;
            auto *go = dynamic_cast<CZ::Protocols::Wayland::GOutput *>(cs->source());
            if (!go || !go->output())
                return 0;
            return H(go->output());
        }

        static int64_t sc_prov_resolve_output(struct wl_resource *wl_output, void *)
        {
            if (!wl_output)
                return 0;
            LResource *lr = static_cast<LResource *>(wl_resource_get_user_data(wl_output));
            auto *go = dynamic_cast<CZ::Protocols::Wayland::GOutput *>(lr);
            return (go && go->output()) ? H(go->output()) : 0;
        }

        static int64_t sc_prov_scale_permille(int64_t out, void *)
        {
            LOutput *o = outp_quiet(out);
            if (!o)
                return 1000;
            const int64_t k = (int64_t)(o->fractionalScale() * 1000.f + 0.5f);
            return k > 0 ? k : 1000;
        }

        static bool sc_prov_size(int64_t out, int *w, int *h, void *)
        {
            LOutput *o = outp_quiet(out);
            if (!o || !o->image())
                return false;
            const SkISize size = o->image()->size();
            *w = size.width();
            *h = size.height();
            return *w > 0 && *h > 0;
        }

        static bool sc_prov_read(int64_t out, uint8_t *dst, int stride, int w, int h, uint32_t shm_format, void *)
        {
            LOutput *o = outp_quiet(out);
            if (!o || !o->image())
                return false;
            RPixelBufferRegion region {};
            region.offset = SkIPoint::Make(0, 0);
            region.stride = (UInt32)stride;
            region.pixels = dst;
            region.region = SkRegion(SkIRect::MakeWH(w, h));
            region.format = shm_format == WL_SHM_FORMAT_XRGB8888 ? DRM_FORMAT_XRGB8888 : DRM_FORMAT_ARGB8888;
            return o->image()->readPixels(region);
        }

        // Wlacza (1) albo wylacza (0) globala ext-image-copy-capture-v1; wolac po vcn_start.
        int64_t vcn_screencopy_enable(int64_t on)
        {
            if (!thread_ok()) return 0;
            if (!g_comp)
                return 0;
            if (!on)
            {
                vcn_sc_shutdown();
                return 1;
            }
            ScProvider p;
            p.resolve = sc_prov_resolve;
            p.size = sc_prov_size;
            p.read = sc_prov_read;
            p.resolve_output = sc_prov_resolve_output;
            p.scale_permille = sc_prov_scale_permille;
            if (!vcn_sc_init(LCompositor::display(), p))
            {
                set_error(VCN_E_STATE, "screencopy: nie mozna utworzyc globala (juz wlaczony albo brak wl_display)");
                return 0;
            }
            return 1;
        }
        int64_t vcn_screencopy_sessions(void) { if (!thread_ok()) return 0; return vcn_sc_session_count(); }
        int64_t vcn_screencopy_frames(void) { if (!thread_ok()) return 0; return vcn_sc_frames_ok(); }

        int64_t vcn_start(void)
        {
            if (!thread_ok()) return 0;
            if (!g_comp)
            {
                g_last_error = "vcn_start przed vcn_init";
                return 0;
            }
            if (!g_comp->start())
            {
                g_last_error = "LCompositor::start() nie powiodlo sie (backend, DRM/libseat, gniazdo Wayland)";
                return 0;
            }
            return 1;
        }
        static void vcn_pump_hooks(void);

        int64_t vcn_dispatch(int64_t ms)
        {
            if (!thread_ok()) return 0;
            if (!g_comp)
                return -1;
            vcn_pump_hooks();
            return (int64_t)g_comp->dispatch((int)ms);
        }
        int64_t vcn_state(void) { if (!thread_ok()) return 0; return g_comp ? (int64_t)g_comp->state() : -1; }
        int64_t vcn_fd(void) { if (!thread_ok()) return 0; return g_comp ? (int64_t)g_comp->fd() : -1; }

        void vcn_finish(void)
        {
            if (!thread_ok()) return;
            if (g_comp)
                g_comp->finish();
        }

        void vcn_destroy(void)
        {
            if (!thread_ok()) return;
            delete g_comp;
            g_comp = nullptr;
            g_queue.clear();
        }

        // ---- bufory napisow ----
        void vcn_buf_clear(int64_t slot)
        {
            if (!thread_ok()) return;
            if (slot == 0)
                g_buf0.clear();
            else
                g_buf1.clear();
        }

        void vcn_buf_push(int64_t slot, int64_t byte)
        {
            if (!thread_ok()) return;
            char c = (char)(byte & 0xFF);
            if (slot == 0)
                g_buf0.push_back(c);
            else
                g_buf1.push_back(c);
        }

        int64_t vcn_setenv(int64_t overwrite)
        {
            if (!thread_ok()) return 0;
            return setenv(g_buf0.c_str(), g_buf1.c_str(), overwrite ? 1 : 0) == 0 ? 1 : 0;
        }

        int64_t vcn_spawn(void)
        {
            if (!thread_ok()) return 0;
            // podwojny fork: brak zombie, nie ruszamy obslugi sygnalow Louvre
            pid_t child = fork();
            if (child < 0)
                return 0;
            if (child == 0)
            {
                pid_t grand = fork();
                if (grand != 0)
                    _exit(0);
                const char *disp = getenv("CZ_LOUVRE_WAYLAND_DISPLAY");
                if (disp)
                    setenv("WAYLAND_DISPLAY", disp, 1);
                execl("/bin/sh", "sh", "-c", g_buf0.c_str(), (char *)nullptr);
                _exit(127);
            }
            int status = 0;
            waitpid(child, &status, 0);
            return 1;
        }

        void vcn_set_manual_policy(int64_t manual) { if (!thread_ok()) return; g_manual = manual != 0; }

        // ---- kolejka zdarzen ----
        int64_t vcn_poll(void)
        {
            if (!thread_ok()) return 0;
            if (g_queue.empty())
                return 0;
            g_cur = g_queue.front();
            g_queue.pop_front();
            return 1;
        }

