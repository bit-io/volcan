        const char *vcn_output_name_c(int64_t h) { if (!thread_ok()) return ""; LOutput *o = outp(h); return vcn_ring(o ? std::string(o->name()) : std::string()); }
        const char *vcn_seat_name_c(void) { if (!thread_ok()) return ""; return vcn_ring(g_comp ? std::string(g_comp->seat()->name()) : std::string()); }

