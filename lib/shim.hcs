        static std::shared_ptr<LOutputMode> vcn_mode(int64_t h, int64_t i)
        {
            LOutput *o = outp(h);
            if (!o || i < 0 || i >= (int64_t)o->modes().size())
                return nullptr;
            return o->modes().at((size_t)i);
        }

