            }
            g_style.texts.push_back(OverlayText { x, y, std::max<int64_t>(4, std::min<int64_t>(size, 200)), (uint32_t)argb, text, group });
            vcn_repaint_all();
            return (int64_t)g_style.texts.size() - 1;
        }

