        // ---- bufory po stronie wywolujacego: zwraca pelna dlugosc, zapisuje maks. cap-1 bajtow + NUL ----
        static int64_t vcn_copy_out(const std::string &s, char *buf, int64_t cap)
        {
            if (buf && cap > 0)
            {
                size_t n = std::min((size_t)(cap - 1), s.size());
                std::memcpy(buf, s.data(), n);
                buf[n] = 0;
            }
            return (int64_t)s.size();
        }

        int64_t vcn_toplevel_title_buf(int64_t h, char *buf, int64_t cap) { if (!thread_ok()) return 0; LToplevelRole *t = top(h); return vcn_copy_out(t ? std::string(t->title()) : std::string(), buf, cap); }
        int64_t vcn_toplevel_app_id_buf(int64_t h, char *buf, int64_t cap) { if (!thread_ok()) return 0; LToplevelRole *t = top(h); return vcn_copy_out(t ? std::string(t->appId()) : std::string(), buf, cap); }
        int64_t vcn_output_name_buf(int64_t h, char *buf, int64_t cap) { if (!thread_ok()) return 0; LOutput *o = outp(h); return vcn_copy_out(o ? std::string(o->name()) : std::string(), buf, cap); }
        int64_t vcn_last_error_buf(char *buf, int64_t cap) { return vcn_copy_out(g_last_error, buf, cap); }

