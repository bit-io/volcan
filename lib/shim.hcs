        int64_t vcn_output_mode_refresh(int64_t h, int64_t i) { if (!thread_ok()) return 0; auto m = vcn_mode(h, i); return m ? (int64_t)m->refreshRate() : 0; }
        int64_t vcn_output_mode_preferred(int64_t h, int64_t i) { if (!thread_ok()) return 0; auto m = vcn_mode(h, i); return (m && m->isPreferred()) ? 1 : 0; }

        int64_t vcn_output_current_mode(int64_t h)
        {
            if (!thread_ok()) return 0;
            LOutput *o = outp(h);
            if (!o)
                return -1;
            auto cur = o->currentMode();
            for (size_t i = 0; i < o->modes().size(); i++)
                if (o->modes().at(i) == cur)
                    return (int64_t)i;
            return -1;
        }

