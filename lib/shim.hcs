        // Trafienie w dekoracje w punkcie globalnym: uchwyt okna (0 gdy brak) i czesc:
        // 1 pasek tytulowy, 2 zamknij, 3 maksymalizuj, 4 minimalizuj.
        static int64_t deco_hit(double fx, double fy, int64_t *part)
        {
            *part = 0;
            if (!g_comp || g_style.deco.mode == 0)
                return 0;
            const int32_t x = (int32_t)std::floor(fx), y = (int32_t)std::floor(fy);
            const auto &all = g_comp->surfaces();
            for (auto it = all.rbegin(); it != all.rend(); ++it)
            {
                DecoGeom g {};
                if (!(*it)->toplevel() || !deco_geom(*it, g))
                    continue;
                if (g.body.contains(x, y))
                    return 0;       // wyzej lezace okno przykrywa dekoracje nizszych
                if (!g.bar.contains(x, y))
                    continue;
                *part = g.close.contains(x, y) ? 2 : g.maxi.contains(x, y) ? 3 : g.mini.contains(x, y) ? 4 : 1;
                return H(*it);
            }
            return 0;
        }

        int64_t vcn_deco_hit_handle(double x, double y) { if (!thread_ok()) return 0; int64_t p; return deco_hit(x, y, &p); }
        int64_t vcn_deco_hit_part(double x, double y) { if (!thread_ok()) return 0; int64_t p; deco_hit(x, y, &p); return p; }

        // ---- tapeta z pliku (png/jpg wg obslugi Ream); tryb: 0 rozciagnij, 1 wypelnij, 2 dopasuj, 3 srodek ----
        int64_t vcn_wallpaper_set_c(const char *path, int64_t mode)
        {
            if (!thread_ok()) return 0;
            if (!path || !*path)
            {
                set_error(VCN_E_ARG, "pusta sciezka tapety");
                return 0;
            }
            auto ream = RCore::Get();
            if (!ream || !ream->mainDevice())
            {
                set_error(VCN_E_STATE, "Ream nie jest zainicjowany (najpierw vcn_start)");
                return 0;
            }
            auto format = ream->mainDevice()->textureFormats().formats().find(DRM_FORMAT_ARGB8888);
            if (format == ream->mainDevice()->textureFormats().formats().end())
            {
                set_error(VCN_E_UNSUPPORTED, "brak formatu ARGB8888 dla tekstur");
                return 0;
            }
            auto image = RImage::LoadFile(path, *format);
            if (!image)
            {
                set_error(VCN_E_IO, "nie mozna wczytac obrazu tapety");
                return 0;
            }
            g_style.wall_image = image;
            g_style.wall_mode = std::max<int64_t>(0, std::min<int64_t>(mode, 3));
            vcn_repaint_all();
            return 1;
        }

        int64_t vcn_wallpaper_set(int64_t mode) { if (!thread_ok()) return 0; return vcn_wallpaper_set_c(g_buf0.c_str(), mode); }
        void vcn_wallpaper_clear(void) { if (!thread_ok()) return; g_style.wall_image.reset(); vcn_repaint_all(); }

        // ---- stan rysowania pojedynczego okna ----
        void vcn_window_set_alpha(int64_t h, int64_t permille)
        {
            if (!thread_ok()) return;
            if (!surf(h)) return;
            g_win[h].alpha = std::max<int64_t>(0, std::min<int64_t>(permille, 1000)) / 1000.0;
            vcn_repaint_all();
        }

        void vcn_window_set_scale(int64_t h, int64_t permille)
        {
            if (!thread_ok()) return;
            if (!surf(h)) return;
            g_win[h].scale = std::max<int64_t>(50, std::min<int64_t>(permille, 2000)) / 1000.0;
            vcn_repaint_all();
        }

        // enabled = 0 zdejmuje wlasny kolor ramki.
        void vcn_window_set_border(int64_t h, int64_t argb, int64_t enabled)
        {
            if (!thread_ok()) return;
            if (!surf(h)) return;
            g_win[h].has_border = enabled != 0;
            g_win[h].border = (uint32_t)argb;
            vcn_repaint_all();
        }

        // ---- animacje: pozycja, krycie, skala; ease: 0 liniowo, 1 zwalnianie, 2 przyspieszanie, 3 gladko ----
        static double anim_ease(int ease, double t)
        {
            t = std::max(0.0, std::min(1.0, t));
            switch (ease)
            {
            case 1: return 1.0 - std::pow(1.0 - t, 3.0);
            case 2: return t * t * t;
            case 3: return t < 0.5 ? 4.0 * t * t * t : 1.0 - std::pow(-2.0 * t + 2.0, 3.0) / 2.0;
            default: return t;
            }
        }

        static void anim_start(const Anim &a)
        {
            g_anims.erase(std::remove_if(g_anims.begin(), g_anims.end(), [&](const Anim &o) { return o.h == a.h && o.kind == a.kind; }), g_anims.end());
            g_anims.push_back(a);
            vcn_repaint_all();
        }

        void vcn_anim_move(int64_t h, int64_t x, int64_t y, int64_t ms, int64_t ease)
        {
            if (!thread_ok()) return;
            LSurface *s = surf(h);
            if (!s) return;
            if (ms <= 0)
            {
                vcn_surface_set_pos(h, x, y);
                return;
            }
            anim_start(Anim { h, 0, (double)s->pos().x(), (double)s->pos().y(), (double)x, (double)y, std::chrono::steady_clock::now(), ms, (int)ease });
        }

        void vcn_anim_fade(int64_t h, int64_t to_permille, int64_t ms, int64_t ease)
        {
            if (!thread_ok()) return;
            if (!surf(h)) return;
            const double to = std::max<int64_t>(0, std::min<int64_t>(to_permille, 1000)) / 1000.0;
            if (ms <= 0)
            {
                g_win[h].alpha = to;
                vcn_repaint_all();
                return;
            }
            anim_start(Anim { h, 1, g_win[h].alpha, 0, to, 0, std::chrono::steady_clock::now(), ms, (int)ease });
        }

        void vcn_anim_scale(int64_t h, int64_t to_permille, int64_t ms, int64_t ease)
        {
            if (!thread_ok()) return;
            if (!surf(h)) return;
            const double to = std::max<int64_t>(50, std::min<int64_t>(to_permille, 2000)) / 1000.0;
            if (ms <= 0)
            {
                g_win[h].scale = to;
                vcn_repaint_all();
                return;
            }
            anim_start(Anim { h, 2, g_win[h].scale, 0, to, 0, std::chrono::steady_clock::now(), ms, (int)ease });
        }

        void vcn_anim_cancel(int64_t h)
        {
            if (!thread_ok()) return;
            g_anims.erase(std::remove_if(g_anims.begin(), g_anims.end(), [&](const Anim &o) { return o.h == h; }), g_anims.end());
        }

        int64_t vcn_anim_active(void) { if (!thread_ok()) return 0; return (int64_t)g_anims.size(); }

        // Krok animacji (wolany z vcn_dispatch); konczace sie animacje daja zdarzenie 98 (a = okno, b = rodzaj).
        static void vcn_anim_tick(void)
        {
            if (g_anims.empty() || !g_comp)
                return;
            const auto now = std::chrono::steady_clock::now();
            std::vector<Anim> keep;
            for (const Anim &a : g_anims)
            {
                if (!surf_quiet(a.h))
                {
                    g_win.erase(a.h);
                    continue;
                }
                const double t = std::chrono::duration<double, std::milli>(now - a.t0).count() / (double)a.dur;
                const double e = anim_ease(a.ease, t);
                if (a.kind == 0)
                    vcn_surface_set_pos(a.h, (int64_t)std::llround(a.x0 + (a.x1 - a.x0) * e), (int64_t)std::llround(a.y0 + (a.y1 - a.y0) * e));
                else if (a.kind == 1)
                    g_win[a.h].alpha = a.x0 + (a.x1 - a.x0) * e;
                else
                    g_win[a.h].scale = a.x0 + (a.x1 - a.x0) * e;
                if (t >= 1.0)
                    push(98, a.h, a.kind);
                else
                    keep.push_back(a);
            }
            g_anims.swap(keep);
            vcn_repaint_all();
        }

        // ---- kursor: ksztalt, motyw, obraz z pliku ----
        // ksztalt wg protokolu cursor-shape (1 domyslny, 4 lapka, 9 tekst, 13 przenoszenie, 18..31 zmiana rozmiaru...).
        void vcn_cursor_set_shape(int64_t shape)
        {
            if (!thread_ok()) return;
            if (!g_comp) return;
            if (shape < 1 || shape > 36)
            {
                set_error(VCN_E_ARG, "nieznany ksztalt kursora");
                return;
            }
            g_comp->cursor()->setSource(LCursorSource::MakeShape(static_cast<CZCursorShape>(shape)));
        }

        int64_t vcn_cursor_set_theme_c(const char *name)
        {
            if (!thread_ok()) return 0;
            if (!g_comp || !name || !*name)
                return 0;
            auto src = LCursorSource::MakeFromTheme(name);
            if (!src)
            {
                set_error(VCN_E_IO, "brak kursora o tej nazwie w motywie");
                return 0;
            }
            g_comp->cursor()->setSource(src);
            return 1;
        }

        int64_t vcn_cursor_set_image_c(const char *path, int64_t hot_x, int64_t hot_y, int64_t size)
        {
            if (!thread_ok()) return 0;
            if (!g_comp || !path || !*path)
                return 0;
            auto ream = RCore::Get();
            if (!ream || !ream->mainDevice())
                return 0;
            auto format = ream->mainDevice()->textureFormats().formats().find(DRM_FORMAT_ARGB8888);
            if (format == ream->mainDevice()->textureFormats().formats().end())
                return 0;
            const int32_t sz = (int32_t)std::max<int64_t>(0, std::min<int64_t>(size, 256));
            auto image = RImage::LoadFile(path, *format, SkISize::Make(sz, sz));
            if (!image)
            {
                set_error(VCN_E_IO, "nie mozna wczytac obrazu kursora");
                return 0;
            }
            g_comp->cursor()->setSource(LCursorSource::Make(image, SkIPoint::Make((int32_t)hot_x, (int32_t)hot_y)));
            return 1;
        }

        int64_t vcn_cursor_set_theme(void) { if (!thread_ok()) return 0; return vcn_cursor_set_theme_c(g_buf0.c_str()); }
        int64_t vcn_cursor_set_image(int64_t hot_x, int64_t hot_y, int64_t size) { if (!thread_ok()) return 0; return vcn_cursor_set_image_c(g_buf0.c_str(), hot_x, hot_y, size); }
        void vcn_cursor_reset(void) { if (!thread_ok()) return; if (g_comp) g_comp->cursor()->setSource({}); }

        // ---- wirtualna klawiatura (zdarzenie klawisza wstrzykiwane do seata, np. z IPC lub ekranu dotykowego) ----
        void vcn_keyboard_send_key(int64_t code, int64_t pressed)
        {
            if (!thread_ok()) return;
            if (!g_comp || code < 0 || code > 767)
            {
                set_error(VCN_E_ARG, "zly kod klawisza");
                return;
            }
            CZKeyboardKeyEvent e;
            e.code = (UInt32)code;
            e.isPressed = pressed != 0;
            g_comp->seat()->keyboard()->keyEvent(e);
        }

        // ---- wyjscia: lustro, miekkie wygaszanie (DPMS), zrzut ekranu ----
        // Wyswietla na `dst` obraz wyjscia `src` (z zachowaniem proporcji); src = 0 konczy lustro.
        void vcn_output_mirror(int64_t dst, int64_t src)
        {
            if (!thread_ok()) return;
            if (!outp(dst)) return;
            if (src == 0)
                g_mirror.erase(dst);
            else if (outp(src) && src != dst)
                g_mirror[dst] = src;
            else
            {
                set_error(VCN_E_ARG, "zle wyjscie zrodlowe lustra");
                return;
            }
            outp(dst)->repaint();
        }

        int64_t vcn_output_mirror_of(int64_t dst) { if (!thread_ok()) return 0; auto it = g_mirror.find(dst); return it == g_mirror.end() ? 0 : it->second; }

        // Louvre nie udostepnia DPMS: wygaszamy rysujac czern i zerujac gamme (gdy wyjscie ja wspiera).
        void vcn_output_set_blank(int64_t h, int64_t blank)
        {
            if (!thread_ok()) return;
            LOutput *o = outp(h);
            if (!o) return;
            if (blank)
                g_blank[h] = true;
            else
                g_blank.erase(h);
            if (o->gammaSize() >= 2)
                vcn_output_set_gamma_scale(h, blank ? 0 : 1000, blank ? 0 : 1000, blank ? 0 : 1000);
            o->repaint();
        }

        int64_t vcn_output_is_blank(int64_t h) { if (!thread_ok()) return 0; return g_blank.count(h) ? 1 : 0; }

        // Zapisuje ostatnia klatke wyjscia jako PNG; 1 przy powodzeniu.
        int64_t vcn_output_screenshot_c(int64_t h, const char *path)
        {
            if (!thread_ok()) return 0;
            LOutput *o = outp(h);
            if (!o || !path || !*path)
                return 0;
            auto img = o->image();
            if (!img)
            {
                set_error(VCN_E_STATE, "wyjscie nie ma jeszcze obrazu");
                return 0;
            }
            const SkISize size = img->size();
            std::vector<uint8_t> px((size_t)size.width() * (size_t)size.height() * 4u);
            RPixelBufferRegion region {};
            region.offset = SkIPoint::Make(0, 0);
            region.stride = (UInt32)size.width() * 4u;
            region.pixels = px.data();
            region.region = SkRegion(SkIRect::MakeSize(size));
            region.format = DRM_FORMAT_ABGR8888;      // w pamieci: R, G, B, A
            if (!img->readPixels(region))
            {
                set_error(VCN_E_IO, "odczyt pikseli wyjscia nie powiodl sie");
                return 0;
            }
            for (size_t i = 3; i < px.size(); i += 4)
                px[i] = 255;
            if (!vcn_png_write_rgba_c(path, size.width(), size.height(), px.data()))
            {
                set_error(VCN_E_IO, "zapis PNG nie powiodl sie");
                return 0;
            }
            return 1;
        }

        int64_t vcn_output_screenshot(int64_t h) { if (!thread_ok()) return 0; return vcn_output_screenshot_c(h, g_buf0.c_str()); }


        // ---- wersje buforowe dla HackerScript ----
        int64_t vcn_layer_scope(int64_t h)
        {
            if (!thread_ok()) return 0;
            LLayerRole *l = lay(h);
            g_buf1 = l ? std::string(l->scope()) : std::string();
            return (int64_t)g_buf1.size();
        }

        // Bufor 0: "uklad\nwariant\nopcje" (puste czesci oznaczaja domyslne).
        int64_t vcn_keyboard_set_keymap(void)
        {
            if (!thread_ok()) return 0;
            std::string parts[3];
            size_t idx = 0;
            for (char c : g_buf0)
            {
                if (c == '\n' && idx < 2)
                    idx++;
                else
                    parts[idx].push_back(c);
            }
            return vcn_keyboard_set_keymap_c(parts[0].c_str(), parts[1].c_str(), parts[2].c_str());
        }

        // ---- odczyt buforow 0/1 (wyniki funkcji konfiguracji, IPC, bledow) ----
        int64_t vcn_buf_len(int64_t slot) { if (!thread_ok()) return 0; return str_len(slot == 1 ? g_buf1 : g_buf0); }
        int64_t vcn_buf_at(int64_t slot, int64_t i) { if (!thread_ok()) return 0; return str_at(slot == 1 ? g_buf1 : g_buf0, i); }

        // BEGIN-LIBINPUT (konfiguracja urzadzen wejsciowych: tylko libinput.h + biblioteka standardowa, testowane osobno)
        // Reguly: "RODZAJ WZORZEC klucz=wartosc ...", RODZAJ to touchpad | pointer | any, WZORZEC to glob nazwy
        // urzadzenia. Klucze: tap, tap_drag, tap_lock, natural_scroll, dwt, middle_emulation, left_handed
        // (on/off), accel_profile (flat/adaptive), accel_speed (-1..1), scroll_method (none/two_finger/edge/button),
        // click_method (none/button_areas/clickfinger). Pozniejsze reguly nadpisuja wczesniejsze.
        struct LiRule
        {
            int kind = 0;
            std::string pattern = "*";
            int tap = -1, tap_drag = -1, tap_lock = -1, natural = -1, dwt = -1, middle = -1, left_handed = -1;
            int accel_profile = -1, scroll_method = -1, click_method = -1;
            bool has_speed = false;
            double speed = 0.0;
        };

        static std::vector<LiRule> g_li_rules;
        static std::string g_li_error;

        static bool li_glob(const char *p, const char *t)
        {
            if (*p == 0)
                return *t == 0;
            if (*p == '*')
                return li_glob(p + 1, t) || (*t != 0 && li_glob(p, t + 1));
            if (*t != 0 && (*p == '?' || *p == *t))
                return li_glob(p + 1, t + 1);
            return false;
        }

        static int li_onoff(const std::string &v)
        {
            if (v == "on" || v == "1" || v == "true" || v == "yes")
                return 1;
            if (v == "off" || v == "0" || v == "false" || v == "no")
                return 0;
            return -1;
        }

        // Parsuje regule; false (i opis w g_li_error) przy bledzie.
        static bool li_parse_rule(const std::string &spec, LiRule &out)
        {
            std::vector<std::string> w;
            size_t i = 0;
            while (i < spec.size())
            {
                while (i < spec.size() && (spec[i] == ' ' || spec[i] == '\t'))
                    i++;
                size_t a = i;
                while (i < spec.size() && spec[i] != ' ' && spec[i] != '\t')
                    i++;
                if (i > a)
                    w.push_back(spec.substr(a, i - a));
            }
            if (w.size() < 2)
            {
                g_li_error = "regula wymaga: RODZAJ WZORZEC [klucz=wartosc ...]";
                return false;
            }
            LiRule r;
            if (w[0] == "touchpad")
                r.kind = 1;
            else if (w[0] == "pointer")
                r.kind = 2;
            else if (w[0] == "any")
                r.kind = 0;
            else
            {
                g_li_error = "nieznany rodzaj urzadzenia: " + w[0];
                return false;
            }
            r.pattern = w[1];
            for (size_t k = 2; k < w.size(); k++)
            {
                size_t eq = w[k].find('=');
                if (eq == std::string::npos || eq == 0)
                {
                    g_li_error = "oczekiwano klucz=wartosc, jest: " + w[k];
                    return false;
                }
                const std::string key = w[k].substr(0, eq);
                const std::string val = w[k].substr(eq + 1);
                int *flag = nullptr;
                if (key == "tap") flag = &r.tap;
                else if (key == "tap_drag") flag = &r.tap_drag;
                else if (key == "tap_lock") flag = &r.tap_lock;
                else if (key == "natural_scroll") flag = &r.natural;
                else if (key == "dwt") flag = &r.dwt;
                else if (key == "middle_emulation") flag = &r.middle;
                else if (key == "left_handed") flag = &r.left_handed;
                if (flag)
                {
                    int v = li_onoff(val);
                    if (v < 0)
                    {
                        g_li_error = "oczekiwano on/off dla " + key + ", jest: " + val;
                        return false;
                    }
                    *flag = v;
                }
                else if (key == "accel_profile")
                {
                    if (val == "flat") r.accel_profile = 0;
                    else if (val == "adaptive") r.accel_profile = 1;
                    else { g_li_error = "accel_profile: flat albo adaptive"; return false; }
                }
                else if (key == "accel_speed")
                {
                    char *end = nullptr;
                    double d = std::strtod(val.c_str(), &end);
                    if (end == val.c_str() || *end != 0 || d < -1.0 || d > 1.0)
                    {
                        g_li_error = "accel_speed: liczba z zakresu -1..1";
                        return false;
                    }
                    r.has_speed = true;
                    r.speed = d;
                }
                else if (key == "scroll_method")
                {
                    if (val == "none") r.scroll_method = 0;
                    else if (val == "two_finger") r.scroll_method = 1;
                    else if (val == "edge") r.scroll_method = 2;
                    else if (val == "button") r.scroll_method = 3;
                    else { g_li_error = "scroll_method: none, two_finger, edge albo button"; return false; }
                }
                else if (key == "click_method")
                {
                    if (val == "none") r.click_method = 0;
                    else if (val == "button_areas") r.click_method = 1;
                    else if (val == "clickfinger") r.click_method = 2;
                    else { g_li_error = "click_method: none, button_areas albo clickfinger"; return false; }
                }
                else
                {
                    g_li_error = "nieznany klucz: " + key;
                    return false;
                }
            }
            out = r;
            return true;
        }

        // 1 touchpad, 2 mysz/inny wskaznik, 0 reszta.
        static int li_kind(libinput_device *d)
        {
            if (libinput_device_config_tap_get_finger_count(d) > 0)
                return 1;
            if (libinput_device_has_capability(d, LIBINPUT_DEVICE_CAP_POINTER))
                return 2;
            return 0;
        }

        // Stosuje jedna regule do urzadzenia; zwraca liczbe ustawien, ktore libinput przyjal.
        static int li_apply_rule(libinput_device *d, const LiRule &r)
        {
            int kind = li_kind(d);
            if (r.kind != 0 && r.kind != kind)
                return 0;
            if (!li_glob(r.pattern.c_str(), libinput_device_get_name(d)))
                return 0;
            int n = 0;
            auto ok = [&](libinput_config_status st)
            {
                if (st == LIBINPUT_CONFIG_STATUS_SUCCESS)
                    n++;
            };
            const bool has_tap = libinput_device_config_tap_get_finger_count(d) > 0;
            if (r.tap >= 0 && has_tap)
                ok(libinput_device_config_tap_set_enabled(d, r.tap ? LIBINPUT_CONFIG_TAP_ENABLED : LIBINPUT_CONFIG_TAP_DISABLED));
            if (r.tap_drag >= 0 && has_tap)
                ok(libinput_device_config_tap_set_drag_enabled(d, r.tap_drag ? LIBINPUT_CONFIG_DRAG_ENABLED : LIBINPUT_CONFIG_DRAG_DISABLED));
            if (r.tap_lock >= 0 && has_tap)
                ok(libinput_device_config_tap_set_drag_lock_enabled(d, r.tap_lock ? LIBINPUT_CONFIG_DRAG_LOCK_ENABLED : LIBINPUT_CONFIG_DRAG_LOCK_DISABLED));
            if (r.natural >= 0 && libinput_device_config_scroll_has_natural_scroll(d))
                ok(libinput_device_config_scroll_set_natural_scroll_enabled(d, r.natural));
            if (r.dwt >= 0 && libinput_device_config_dwt_is_available(d))
                ok(libinput_device_config_dwt_set_enabled(d, r.dwt ? LIBINPUT_CONFIG_DWT_ENABLED : LIBINPUT_CONFIG_DWT_DISABLED));
            if (r.middle >= 0 && libinput_device_config_middle_emulation_is_available(d))
                ok(libinput_device_config_middle_emulation_set_enabled(d, r.middle ? LIBINPUT_CONFIG_MIDDLE_EMULATION_ENABLED : LIBINPUT_CONFIG_MIDDLE_EMULATION_DISABLED));
            if (r.left_handed >= 0 && libinput_device_config_left_handed_is_available(d))
                ok(libinput_device_config_left_handed_set(d, r.left_handed));
            if (libinput_device_config_accel_is_available(d))
            {
                if (r.accel_profile >= 0)
                    ok(libinput_device_config_accel_set_profile(d, r.accel_profile == 0 ? LIBINPUT_CONFIG_ACCEL_PROFILE_FLAT : LIBINPUT_CONFIG_ACCEL_PROFILE_ADAPTIVE));
                if (r.has_speed)
                    ok(libinput_device_config_accel_set_speed(d, r.speed));
            }
            if (r.scroll_method >= 0)
            {
                static const libinput_config_scroll_method m[4] = { LIBINPUT_CONFIG_SCROLL_NO_SCROLL, LIBINPUT_CONFIG_SCROLL_2FG, LIBINPUT_CONFIG_SCROLL_EDGE, LIBINPUT_CONFIG_SCROLL_ON_BUTTON_DOWN };
                if (libinput_device_config_scroll_get_methods(d) & m[r.scroll_method])
                    ok(libinput_device_config_scroll_set_method(d, m[r.scroll_method]));
            }
            if (r.click_method >= 0)
            {
                static const libinput_config_click_method m[3] = { LIBINPUT_CONFIG_CLICK_METHOD_NONE, LIBINPUT_CONFIG_CLICK_METHOD_BUTTON_AREAS, LIBINPUT_CONFIG_CLICK_METHOD_CLICKFINGER };
                if (r.click_method == 0 || (libinput_device_config_click_get_methods(d) & m[r.click_method]))
                    ok(libinput_device_config_click_set_method(d, m[r.click_method]));
            }
            return n;
        }

        // Stosuje wszystkie reguly po kolei (pozniejsze nadpisuja wczesniejsze).
        static int li_apply_all(libinput_device *d)
        {
            int n = 0;
            for (const LiRule &r : g_li_rules)
                n += li_apply_rule(d, r);
            return n;
        }

        void vcn_li_clear(void) { g_li_rules.clear(); g_li_error.clear(); }

        // 1 gdy regula przyjeta; przy bledzie 0 i opis w vcn_li_error.
        int64_t vcn_li_add_rule_c(const char *spec)
        {
            LiRule r;
            if (!spec || !li_parse_rule(spec, r))
            {
                if (!spec)
                    g_li_error = "pusta regula";
                return 0;
            }
            g_li_rules.push_back(r);
            return 1;
        }

        int64_t vcn_li_rule_count(void) { return (int64_t)g_li_rules.size(); }
        int64_t vcn_li_add_rule(void) { return vcn_li_add_rule_c(g_buf0.c_str()); }

        int64_t vcn_li_error(void)
        {
            g_buf1 = g_li_error;
            return (int64_t)g_buf1.size();
        }
        // END-LIBINPUT

        // Stosuje reguly libinput do wszystkich urzadzen; zwraca liczbe urzadzen, w ktorych cos zmieniono.
        int64_t vcn_li_apply(void)
        {
            if (!thread_ok()) return 0;
            if (!g_comp)
                return 0;
            int64_t n = 0;
            for (const auto &dev : g_comp->seat()->inputDevices())
            {
                libinput_device *d = li_handle(dev);
                if (d && li_apply_all(d) > 0)
                    n++;
            }
            return n;
        }

        // Bufor 1: po jednej linii na urzadzenie: "nazwa<TAB>rodzaj<TAB>libinput|inne" (rodzaj: touchpad, pointer,
        // keyboard, touch, other). Zwraca liczbe urzadzen.
        int64_t vcn_li_devices(void)
        {
            if (!thread_ok()) return 0;
            g_buf1.clear();
            if (!g_comp)
                return 0;
            int64_t n = 0;
            for (const auto &dev : g_comp->seat()->inputDevices())
            {
                libinput_device *d = li_handle(dev);
                const char *kind = "other";
                if (d && li_kind(d) == 1)
                    kind = "touchpad";
                else if (dev->caps.has(CZInputDevice::Pointer))
                    kind = "pointer";
                else if (dev->caps.has(CZInputDevice::Keyboard))
                    kind = "keyboard";
                else if (dev->caps.has(CZInputDevice::Touch))
                    kind = "touch";
                if (n > 0)
                    g_buf1.push_back('\n');
                g_buf1 += dev->name + "\t" + kind + "\t" + (d ? "libinput" : "inne");
                n++;
            }
            return n;
        }

        // BEGIN-STANDALONE (konfiguracja, IPC, procesy, pliki, PNG: tylko biblioteka standardowa + POSIX, testowane osobno)
        // Funkcje tego bloku sa bezpieczne wzgledem watkow (muteksy), w odroznieniu od reszty shima.
        static std::mutex g_sa_mx;

        static const char *sring(const std::string &s)
        {
            static std::string pool[32];
            static unsigned idx = 0;
            std::string &slot = pool[idx++ % 32u];
            slot = s;
            return slot.c_str();
        }

        static std::string trim_str(const std::string &in)
        {
            size_t a = 0, b = in.size();
            while (a < b && (in[a] == ' ' || in[a] == '\t' || in[a] == '\r'))
                a++;
            while (b > a && (in[b - 1] == ' ' || in[b - 1] == '\t' || in[b - 1] == '\r'))
                b--;
            return in.substr(a, b - a);
        }

        static std::map<std::string, std::string> g_cfg;

        // Plik: linie klucz = wartosc, komentarze po # lub ;, sekcje [nazwa] daja prefiks nazwa.klucz.
        int64_t vcn_config_load_c(const char *path)
        {
            if (!path)
                return -1;
            FILE *f = std::fopen(path, "r");
            if (!f)
                return -1;
            std::lock_guard<std::mutex> lk(g_sa_mx);
            std::string section;
            std::string line;
            int64_t loaded = 0;
            int ch;
            auto handle = [&](std::string raw)
            {
                std::string t = trim_str(raw);
                if (t.empty() || t[0] == '#' || t[0] == ';')
                    return;
                if (t[0] == '[' && t.back() == ']')
                {
                    section = trim_str(t.substr(1, t.size() - 2));
                    return;
                }
                size_t eq = t.find('=');
                if (eq == std::string::npos)
                    return;
                std::string key = trim_str(t.substr(0, eq));
                std::string val = trim_str(t.substr(eq + 1));
                if (key.empty())
                    return;
                if (val.size() >= 2 && ((val.front() == '"' && val.back() == '"') || (val.front() == '\'' && val.back() == '\'')))
                    val = val.substr(1, val.size() - 2);
                else
                {
                    size_t hash = val.find(" #");
                    if (hash != std::string::npos)
                        val = trim_str(val.substr(0, hash));
                }
                g_cfg[section.empty() ? key : section + "." + key] = val;
                loaded++;
            };
            while ((ch = std::fgetc(f)) != EOF)
            {
                if (ch == '\n')
                {
                    handle(line);
                    line.clear();
                }
                else if (line.size() < 4096)
                    line.push_back((char)ch);
            }
            if (!line.empty())
                handle(line);
            std::fclose(f);
            return loaded;
        }

        int64_t vcn_config_has_c(const char *key)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            return (key && g_cfg.count(key)) ? 1 : 0;
        }

        const char *vcn_config_get_c(const char *key)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            auto it = key ? g_cfg.find(key) : g_cfg.end();
            return sring(it == g_cfg.end() ? std::string() : it->second);
        }

        int64_t vcn_config_int_c(const char *key, int64_t def)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            auto it = key ? g_cfg.find(key) : g_cfg.end();
            if (it == g_cfg.end() || it->second.empty())
                return def;
            char *end = nullptr;
            long long v = std::strtoll(it->second.c_str(), &end, 10);
            return (end && *end == 0) ? (int64_t)v : def;
        }

        void vcn_config_set_c(const char *key, const char *value)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            if (key)
                g_cfg[key] = value ? value : "";
        }

        void vcn_config_clear(void)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            g_cfg.clear();
        }

        int64_t vcn_config_count(void)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            return (int64_t)g_cfg.size();
        }

        const char *vcn_config_key_at_c(int64_t i)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            if (i < 0 || i >= (int64_t)g_cfg.size())
                return sring(std::string());
            auto it = g_cfg.begin();
            std::advance(it, (long)i);
            return sring(it->first);
        }

        // Wersje dla HackerScript: argumenty w buforze 0, wynik w buforze 1 (tylko z jednego watku).
        int64_t vcn_config_load(void) { return vcn_config_load_c(g_buf0.c_str()); }

        int64_t vcn_config_lookup(void)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            auto it = g_cfg.find(g_buf0);
            if (it == g_cfg.end())
            {
                g_buf1.clear();
                return 0;
            }
            g_buf1 = it->second;
            return 1;
        }

        int64_t vcn_config_lookup_int(int64_t def) { return vcn_config_int_c(g_buf0.c_str(), def); }

        void vcn_config_store(void)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            g_cfg[g_buf0] = g_buf1;
        }

        // ---- IPC: gniazdo UNIX, jedna linia polecenia na polaczenie ----
        // Zabezpieczenia: tryb gniazda (domyslnie 0600), kontrola UID rozmowcy (SO_PEERCRED),
        // opcjonalny token ("<token> polecenie"), limit dlugosci linii, limit polaczen na sekunde
        // i limit czasu bezczynnego klienta. Odrzucone polaczenia sa liczone (vcn_ipc_stat).
        static std::mutex g_ipc_mx;
        static int g_ipc_listen = -1;
        static int g_ipc_client = -1;
        static std::string g_ipc_path;
        static std::string g_ipc_inbuf;
        static std::string g_ipc_line;
        static std::string g_ipc_token;
        static int64_t g_ipc_mode = 0600;
        static std::vector<uid_t> g_ipc_uids;
        static int64_t g_ipc_stats[5] = { 0, 0, 0, 0, 0 };
        static std::deque<std::chrono::steady_clock::time_point> g_ipc_conns;
        static std::chrono::steady_clock::time_point g_ipc_client_since;

        static void ipc_drop_client(void)
        {
            if (g_ipc_client >= 0)
                ::close(g_ipc_client);
            g_ipc_client = -1;
            g_ipc_inbuf.clear();
        }

        static void ipc_reject(const char *msg)
        {
            if (g_ipc_client >= 0)
            {
                std::string out = std::string(msg) + "\n";
                (void)!::write(g_ipc_client, out.data(), out.size());
                // Wyslij odpowiedz i oproznij nieodczytane dane, zeby close() nie wyslal RST,
                // ktory moglby skasowac komunikat o bledzie po stronie klienta.
                ::shutdown(g_ipc_client, SHUT_WR);
                char sink[1024];
                for (int i = 0; i < 64 && ::read(g_ipc_client, sink, sizeof(sink)) > 0; i++)
                {
                }
            }
            ipc_drop_client();
        }

        // Przed vcn_ipc_listen: tryb pliku gniazda (np. 0600, 0660).
        void vcn_ipc_set_mode(int64_t mode) { std::lock_guard<std::mutex> lk(g_ipc_mx); g_ipc_mode = mode & 0777; }
        // Dodatkowy UID, ktoremu wolno rozmawiac (poza wlascicielem procesu).
        void vcn_ipc_allow_uid(int64_t uid) { std::lock_guard<std::mutex> lk(g_ipc_mx); g_ipc_uids.push_back((uid_t)uid); }
        // Pusty token wylacza wymaganie tokenu.
        void vcn_ipc_set_token_c(const char *token) { std::lock_guard<std::mutex> lk(g_ipc_mx); g_ipc_token = token ? token : ""; }
        // 0 przyjete, 1 odrzucone UID, 2 odrzucone token, 3 za dluga linia, 4 limit polaczen.
        int64_t vcn_ipc_stat(int64_t which) { std::lock_guard<std::mutex> lk(g_ipc_mx); return (which >= 0 && which < 5) ? g_ipc_stats[which] : 0; }

        int64_t vcn_ipc_listen_c(const char *path)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            if (!path || !*path || std::strlen(path) >= sizeof(((sockaddr_un *)0)->sun_path))
                return 0;
            if (g_ipc_listen >= 0)
                return 0;
            int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
            if (fd < 0)
                return 0;
            ::unlink(path);
            sockaddr_un addr {};
            addr.sun_family = AF_UNIX;
            std::strncpy(addr.sun_path, path, sizeof(addr.sun_path) - 1);
            mode_t old = ::umask(0177);
            int rc = ::bind(fd, (sockaddr *)&addr, sizeof(addr));
            ::umask(old);
            if (rc != 0 || ::chmod(path, (mode_t)g_ipc_mode) != 0 || ::listen(fd, 8) != 0)
            {
                ::close(fd);
                return 0;
            }
            g_ipc_listen = fd;
            g_ipc_path = path;
            for (auto &x : g_ipc_stats)
                x = 0;
            return 1;
        }

        int64_t vcn_ipc_fd(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            return g_ipc_listen;
        }

        // Zwraca 1, gdy jest nowe polecenie (odczytaj przez vcn_ipc_line_c i odpowiedz vcn_ipc_reply_c).
        int64_t vcn_ipc_poll(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            if (g_ipc_listen < 0)
                return 0;
            const auto now = std::chrono::steady_clock::now();
            if (g_ipc_client >= 0 && now - g_ipc_client_since > std::chrono::seconds(2))
                ipc_drop_client();
            if (g_ipc_client >= 0 && !g_ipc_line.empty())
                return 1;
            if (g_ipc_client < 0)
            {
                int c = ::accept4(g_ipc_listen, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
                if (c < 0)
                    return 0;
                g_ipc_client = c;
                g_ipc_client_since = now;
                g_ipc_inbuf.clear();
                g_ipc_line.clear();
                while (!g_ipc_conns.empty() && now - g_ipc_conns.front() > std::chrono::seconds(1))
                    g_ipc_conns.pop_front();
                if (g_ipc_conns.size() >= 200)
                {
                    g_ipc_stats[4]++;
                    ipc_reject("error: za wiele polaczen");
                    return 0;
                }
                g_ipc_conns.push_back(now);
                ucred cred {};
                socklen_t len = sizeof(cred);
                bool ok = ::getsockopt(c, SOL_SOCKET, SO_PEERCRED, &cred, &len) == 0;
                if (ok)
                {
                    ok = cred.uid == ::geteuid();
                    for (uid_t u : g_ipc_uids)
                        ok = ok || cred.uid == u;
                }
                if (!ok)
                {
                    g_ipc_stats[1]++;
                    ipc_reject("error: brak uprawnien");
                    return 0;
                }
            }
            char tmp[512];
            for (;;)
            {
                ssize_t n = ::read(g_ipc_client, tmp, sizeof(tmp));
                if (n > 0)
                {
                    g_ipc_inbuf.append(tmp, (size_t)n);
                    size_t nl = g_ipc_inbuf.find('\n');
                    if (nl != std::string::npos)
                    {
                        std::string line = trim_str(g_ipc_inbuf.substr(0, nl));
                        g_ipc_inbuf.clear();
                        if (line.size() > 4096)
                        {
                            g_ipc_stats[3]++;
                            ipc_reject("error: linia za dluga");
                            return 0;
                        }
                        if (!g_ipc_token.empty())
                        {
                            const std::string prefix = g_ipc_token + " ";
                            if (line.compare(0, prefix.size(), prefix) != 0)
                            {
                                g_ipc_stats[2]++;
                                ipc_reject("error: brak autoryzacji");
                                return 0;
                            }
                            line = trim_str(line.substr(prefix.size()));
                        }
                        g_ipc_line = line;
                        g_ipc_stats[0]++;
                        return 1;
                    }
                    if (g_ipc_inbuf.size() > 4096)
                    {
                        g_ipc_stats[3]++;
                        ipc_reject("error: linia za dluga");
                        return 0;
                    }
                    continue;
                }
                if (n == 0)
                    ipc_drop_client();
                break;
            }
            return 0;
        }

        const char *vcn_ipc_line_c(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            std::lock_guard<std::mutex> lk2(g_sa_mx);
            return sring(g_ipc_line);
        }

        int64_t vcn_ipc_line(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            g_buf1 = g_ipc_line;
            return (int64_t)g_buf1.size();
        }

        int64_t vcn_ipc_reply_c(const char *text)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            if (g_ipc_client < 0)
                return 0;
            std::string out = text ? text : "";
            out.push_back('\n');
            size_t off = 0;
            while (off < out.size())
            {
                ssize_t n = ::write(g_ipc_client, out.data() + off, out.size() - off);
                if (n > 0)
                    off += (size_t)n;
                else if (n < 0 && (errno == EAGAIN || errno == EINTR))
                {
                    pollfd pfd { g_ipc_client, POLLOUT, 0 };
                    ::poll(&pfd, 1, 200);
                }
                else
                    break;
            }
            ipc_drop_client();
            g_ipc_line.clear();
            return off == out.size() ? 1 : 0;
        }

        // ---- IPC: subskrypcje zdarzen (trwale polaczenia) ----
        // Zamiast ipc_reply skrypt moze wywolac vcn_ipc_subscribe_c: biezacy klient dostaje "ok",
        // przestaje byc obslugiwany jako klient polecen i staje sie subskrybentem. Kazde
        // vcn_ipc_publish_c wysyla linie do wszystkich subskrybentow. Wolny albo martwy odbiorca
        // (EAGAIN, EPIPE, niepelny zapis) jest od razu odlaczany, wiec nie blokuje kompozytora.
        static std::vector<int> g_ipc_subs;

        static void ipc_subs_close_all(void)
        {
            for (int fd : g_ipc_subs)
                ::close(fd);
            g_ipc_subs.clear();
        }

        // 1 gdy klient zostal subskrybentem; 0 gdy nie ma klienta albo jest limit (16 subskrybentow).
        int64_t vcn_ipc_subscribe_c(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            if (g_ipc_client < 0 || g_ipc_subs.size() >= 16)
                return 0;
            static const char ok[] = "ok\n";
            if (::send(g_ipc_client, ok, sizeof(ok) - 1, MSG_NOSIGNAL) != (ssize_t)(sizeof(ok) - 1))
                return 0;
            g_ipc_subs.push_back(g_ipc_client);
            g_ipc_client = -1;
            g_ipc_inbuf.clear();
            g_ipc_line.clear();
            return 1;
        }

        // Liczba subskrybentow, do ktorych linia dotarla w calosci.
        int64_t vcn_ipc_publish_c(const char *text)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            if (!text || g_ipc_subs.empty())
                return 0;
            std::string out = text;
            if (out.size() > 4096)
                out.resize(4096);
            out.push_back('\n');
            int64_t delivered = 0;
            std::vector<int> keep;
            for (int fd : g_ipc_subs)
            {
                ssize_t n = ::send(fd, out.data(), out.size(), MSG_NOSIGNAL | MSG_DONTWAIT);
                if (n == (ssize_t)out.size())
                {
                    delivered++;
                    keep.push_back(fd);
                }
                else
                    ::close(fd);
            }
            g_ipc_subs.swap(keep);
            return delivered;
        }

        int64_t vcn_ipc_subscribers(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            return (int64_t)g_ipc_subs.size();
        }

        int64_t vcn_ipc_subscribe(void) { return vcn_ipc_subscribe_c(); }
        int64_t vcn_ipc_publish(void) { return vcn_ipc_publish_c(g_buf0.c_str()); }

        int64_t vcn_ipc_listen(void) { return vcn_ipc_listen_c(g_buf0.c_str()); }
        int64_t vcn_ipc_reply(void) { return vcn_ipc_reply_c(g_buf0.c_str()); }
        void vcn_ipc_set_token(void) { vcn_ipc_set_token_c(g_buf0.c_str()); }

        void vcn_ipc_close(void)
        {
            std::lock_guard<std::mutex> lk(g_ipc_mx);
            ipc_drop_client();
            g_ipc_line.clear();
            ipc_subs_close_all();
            if (g_ipc_listen >= 0)
            {
                ::close(g_ipc_listen);
                ::unlink(g_ipc_path.c_str());
            }
            g_ipc_listen = -1;
        }

        // ---- procesy: uruchamianie z numerem PID i odbior informacji o zakonczeniu ----
        static std::mutex g_proc_mx;
        static std::vector<pid_t> g_procs;
        static int64_t g_proc_status = 0;

        // Uruchamia `sh -c polecenie`; zwraca PID albo -1. Dziecko dostaje WAYLAND_DISPLAY kompozytora
        // (z CZ_LOUVRE_WAYLAND_DISPLAY, jesli ustawione). Zakonczenie odbierz przez vcn_process_reap.
        int64_t vcn_process_start_c(const char *command)
        {
            if (!command || !*command)
                return -1;
            std::lock_guard<std::mutex> lk(g_proc_mx);
            pid_t pid = ::fork();
            if (pid < 0)
                return -1;
            if (pid == 0)
            {
                ::setpgid(0, 0);
                const char *disp = ::getenv("CZ_LOUVRE_WAYLAND_DISPLAY");
                if (disp)
                    ::setenv("WAYLAND_DISPLAY", disp, 1);
                ::execl("/bin/sh", "sh", "-c", command, (char *)nullptr);
                ::_exit(127);
            }
            g_procs.push_back(pid);
            return (int64_t)pid;
        }

        // Odbiera jeden zakonczony proces z listy sledzonych: 1 gdy jest, *pid i *status
        // (kod wyjscia albo 128 + numer sygnalu). Zwraca 0, gdy nic sie nie zakonczylo.
        int64_t vcn_process_reap(int64_t *pid_out, int64_t *status_out)
        {
            std::lock_guard<std::mutex> lk(g_proc_mx);
            for (size_t i = 0; i < g_procs.size(); i++)
            {
                int st = 0;
                pid_t r = ::waitpid(g_procs[i], &st, WNOHANG);
                if (r == g_procs[i] || (r < 0 && errno == ECHILD))
                {
                    int64_t code = WIFEXITED(st) ? WEXITSTATUS(st) : (WIFSIGNALED(st) ? 128 + WTERMSIG(st) : 0);
                    if (pid_out)
                        *pid_out = (int64_t)g_procs[i];
                    if (status_out)
                        *status_out = code;
                    g_procs.erase(g_procs.begin() + (long)i);
                    return 1;
                }
            }
            return 0;
        }

        int64_t vcn_process_kill(int64_t pid, int64_t sig)
        {
            std::lock_guard<std::mutex> lk(g_proc_mx);
            for (pid_t p : g_procs)
                if ((int64_t)p == pid)
                    return ::kill(-p, (int)sig) == 0 || ::kill(p, (int)sig) == 0 ? 1 : 0;
            return 0;
        }

        int64_t vcn_process_count(void)
        {
            std::lock_guard<std::mutex> lk(g_proc_mx);
            return (int64_t)g_procs.size();
        }

        // Wersje dla HackerScript: polecenie w buforze 0.
        int64_t vcn_process_start(void) { return vcn_process_start_c(g_buf0.c_str()); }

        // Zwraca PID zakonczonego procesu albo 0; kod wyjscia: vcn_process_status().
        int64_t vcn_process_poll(void)
        {
            int64_t pid = 0, st = 0;
            if (vcn_process_reap(&pid, &st) == 1)
            {
                g_proc_status = st;
                return pid;
            }
            return 0;
        }

        int64_t vcn_process_status(void) { return g_proc_status; }

        // ---- pliki ----
        // Zapis atomowy (plik tymczasowy + rename); 1 przy powodzeniu.
        int64_t vcn_file_write_c(const char *path, const char *data, int64_t len)
        {
            if (!path || !*path || len < 0 || (len > 0 && !data))
                return 0;
            std::string tmp = std::string(path) + ".tmp";
            FILE *f = std::fopen(tmp.c_str(), "wb");
            if (!f)
                return 0;
            bool ok = len == 0 || std::fwrite(data, 1, (size_t)len, f) == (size_t)len;
            ok = (std::fclose(f) == 0) && ok;
            if (!ok || std::rename(tmp.c_str(), path) != 0)
            {
                std::remove(tmp.c_str());
                return 0;
            }
            return 1;
        }

        // Wersje dla HackerScript: sciezka w buforze 0, dane w buforze 1.
        int64_t vcn_file_write(void) { return vcn_file_write_c(g_buf0.c_str(), g_buf1.data(), (int64_t)g_buf1.size()); }

        // Czyta plik (sciezka w buforze 0, maks. 4 MiB) do bufora 1; zwraca dlugosc albo -1.
        int64_t vcn_file_read(void)
        {
            FILE *f = std::fopen(g_buf0.c_str(), "rb");
            if (!f)
                return -1;
            g_buf1.clear();
            char tmp[4096];
            size_t n;
            while ((n = std::fread(tmp, 1, sizeof(tmp), f)) > 0 && g_buf1.size() < (4u << 20))
                g_buf1.append(tmp, n);
            std::fclose(f);
            return (int64_t)g_buf1.size();
        }

        // ---- PNG bez zewnetrznych bibliotek (bloki deflate "stored") ----
        static uint32_t png_crc(uint32_t crc, const uint8_t *p, size_t n)
        {
            static uint32_t table[256];
            static bool ready = false;
            if (!ready)
            {
                for (uint32_t i = 0; i < 256; i++)
                {
                    uint32_t c = i;
                    for (int k = 0; k < 8; k++)
                        c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
                    table[i] = c;
                }
                ready = true;
            }
            crc = ~crc;
            for (size_t i = 0; i < n; i++)
                crc = table[(crc ^ p[i]) & 0xFF] ^ (crc >> 8);
            return ~crc;
        }

        static void png_put32(std::string &o, uint32_t v)
        {
            o.push_back((char)(v >> 24));
            o.push_back((char)(v >> 16));
            o.push_back((char)(v >> 8));
            o.push_back((char)v);
        }

        static void png_chunk(std::string &o, const char *type, const std::string &data)
        {
            png_put32(o, (uint32_t)data.size());
            std::string body = std::string(type, 4) + data;
            o += body;
            png_put32(o, png_crc(0, (const uint8_t *)body.data(), body.size()));
        }

        // Zapisuje obraz RGBA (4 bajty na piksel, wiersz po wierszu, bez przerw) jako PNG; 1 przy powodzeniu.
        int64_t vcn_png_write_rgba_c(const char *path, int64_t w, int64_t h, const uint8_t *rgba)
        {
            if (!path || w <= 0 || h <= 0 || w > 16384 || h > 16384 || !rgba)
                return 0;
            std::string raw;
            raw.reserve((size_t)h * ((size_t)w * 4 + 1));
            for (int64_t y = 0; y < h; y++)
            {
                raw.push_back(0);
                raw.append((const char *)rgba + (size_t)y * (size_t)w * 4, (size_t)w * 4);
            }
            std::string z;
            z.push_back((char)0x78);
            z.push_back((char)0x01);
            size_t pos = 0;
            do
            {
                size_t n = std::min<size_t>(65535, raw.size() - pos);
                bool last = pos + n >= raw.size();
                z.push_back(last ? 1 : 0);
                z.push_back((char)(n & 0xFF));
                z.push_back((char)(n >> 8));
                z.push_back((char)(~n & 0xFF));
                z.push_back((char)((~n >> 8) & 0xFF));
                z.append(raw, pos, n);
                pos += n;
            } while (pos < raw.size());
            uint32_t a = 1, b = 0;
            for (unsigned char c : raw)
            {
                a = (a + c) % 65521u;
                b = (b + a) % 65521u;
            }
            png_put32(z, (b << 16) | a);
            std::string out("\x89PNG\r\n\x1a\n", 8);
            std::string ihdr;
            png_put32(ihdr, (uint32_t)w);
            png_put32(ihdr, (uint32_t)h);
            ihdr.push_back(8);
            ihdr.push_back(6);
            ihdr.push_back(0);
            ihdr.push_back(0);
            ihdr.push_back(0);
            png_chunk(out, "IHDR", ihdr);
            png_chunk(out, "IDAT", z);
            png_chunk(out, "IEND", std::string());
            return vcn_file_write_c(path, out.data(), (int64_t)out.size());
        }

        // ---- obserwator pliku konfiguracji (inotify na katalogu: dziala tez przy zapisie przez rename) ----
        static int g_watch_fd = -1;
        static std::string g_watch_name;
        static bool g_watch_dirty = false;
        static std::chrono::steady_clock::time_point g_watch_last;

        void vcn_watch_close(void)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            if (g_watch_fd >= 0)
                ::close(g_watch_fd);
            g_watch_fd = -1;
            g_watch_dirty = false;
        }

        // Zaczyna obserwowac plik (zastepuje poprzedni). 1 przy powodzeniu.
        int64_t vcn_watch_set_c(const char *path)
        {
            if (!path || !*path)
                return 0;
            std::string full = path;
            size_t slash = full.rfind('/');
            std::string dir = slash == std::string::npos ? "." : (slash == 0 ? "/" : full.substr(0, slash));
            std::string name = slash == std::string::npos ? full : full.substr(slash + 1);
            if (name.empty())
                return 0;
            vcn_watch_close();
            std::lock_guard<std::mutex> lk(g_sa_mx);
            int fd = ::inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
            if (fd < 0)
                return 0;
            if (::inotify_add_watch(fd, dir.c_str(), IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE | IN_ATTRIB) < 0)
            {
                ::close(fd);
                return 0;
            }
            g_watch_fd = fd;
            g_watch_name = name;
            g_watch_dirty = false;
            return 1;
        }

        // 1, gdy obserwowany plik zmienil sie i przez 150 ms nie bylo juz kolejnych zmian (edytory zapisuja
        // plik kilkoma operacjami). Wolac w petli glownej; nie blokuje.
        int64_t vcn_watch_poll(void)
        {
            std::lock_guard<std::mutex> lk(g_sa_mx);
            if (g_watch_fd < 0)
                return 0;
            alignas(inotify_event) char buf[4096];
            for (;;)
            {
                ssize_t n = ::read(g_watch_fd, buf, sizeof(buf));
                if (n <= 0)
                    break;
                for (char *p = buf; p < buf + n;)
                {
                    const inotify_event *ev = (const inotify_event *)p;
                    if (ev->len > 0 && g_watch_name == ev->name)
                    {
                        g_watch_dirty = true;
                        g_watch_last = std::chrono::steady_clock::now();
                    }
                    p += sizeof(inotify_event) + ev->len;
                }
            }
            if (g_watch_dirty && std::chrono::steady_clock::now() - g_watch_last >= std::chrono::milliseconds(150))
            {
                g_watch_dirty = false;
                return 1;
            }
            return 0;
        }

        int64_t vcn_watch_set(void) { return vcn_watch_set_c(g_buf0.c_str()); }


        // Zegar: milisekundy monotoniczne (liczniki bezczynnosci) i czas lokalny wg strftime (widzety paska).
        int64_t vcn_now_ms(void)
        {
            return (int64_t)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
        }

        const char *vcn_strftime_c(const char *fmt, int64_t unix_seconds)
        {
            static std::string out;
            out.clear();
            if (!fmt || !*fmt)
                return "";
            time_t tt = unix_seconds >= 0 ? (time_t)unix_seconds : ::time(nullptr);
            struct tm tmv {};
            ::localtime_r(&tt, &tmv);
            char buf[256];
            const size_t n = ::strftime(buf, sizeof(buf), fmt, &tmv);
            out.assign(buf, n);
            return out.c_str();
        }

        int64_t vcn_strftime(void)
        {
            g_buf1 = vcn_strftime_c(g_buf0.c_str(), -1);
            return (int64_t)g_buf1.size();
        }
        // END-STANDALONE

        // BEGIN-I3IPC (serwer IPC zgodny z sway/i3: swaymsg, i3-msg, waybar; tylko biblioteka standardowa + POSIX, testowany osobno)
        // Ramka: "i3-ipc" + dlugosc u32 + typ u32 (kolejnosc bajtow hosta) + tresc. Zdarzenia maja najwyzszy bit typu ustawiony.
        // Typy obslugiwane od reki: SUBSCRIBE, GET_VERSION, GET_MARKS, GET_BAR_CONFIG, GET_BINDING_MODES, GET_CONFIG, SEND_TICK,
        // SYNC, GET_BINDING_STATE, GET_INPUTS, GET_SEATS. RUN_COMMAND, GET_WORKSPACES, GET_OUTPUTS i GET_TREE trafiaja do skryptu
        // (vcn_i3_poll / vcn_i3_reply_c). Gniazdo ma tryb 0600, a polaczenia innych uzytkownikow niz wlasciciel sa odrzucane.
        struct I3Client
        {
            int64_t id = 0;
            int fd = -1;
            std::string in;
            std::string out;
            uint32_t subs = 0;
            bool dead = false;
        };

        struct I3Req
        {
            int64_t cid = 0;
            uint32_t type = 0;
            std::string payload;
        };

        static int g_i3_listen = -1;
        static std::string g_i3_path;
        static std::vector<I3Client> g_i3_clients;
        static std::deque<I3Req> g_i3_queue;
        static I3Req g_i3_cur;
        static bool g_i3_have = false;
        static int64_t g_i3_next_id = 1;
        static int64_t g_i3_rejected = 0;

        static void i3_frame(std::string &dst, uint32_t type, const std::string &payload)
        {
            const uint32_t len = (uint32_t)payload.size();
            dst.append("i3-ipc", 6);
            dst.append((const char *)&len, 4);
            dst.append((const char *)&type, 4);
            dst.append(payload);
        }

        static void i3_flush(I3Client &c)
        {
            while (!c.out.empty() && !c.dead)
            {
                const ssize_t n = ::send(c.fd, c.out.data(), c.out.size(), MSG_NOSIGNAL | MSG_DONTWAIT);
                if (n > 0)
                    c.out.erase(0, (size_t)n);
                else if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK))
                    break;
                else
                    c.dead = true;
            }
            if (c.out.size() > (4u << 20))
                c.dead = true;          // wolny odbiorca nie moze zjadac pamieci
        }

        static I3Client *i3_find(int64_t id)
        {
            for (I3Client &c : g_i3_clients)
                if (c.id == id && !c.dead)
                    return &c;
            return nullptr;
        }

        static void i3_send(I3Client &c, uint32_t type, const std::string &payload)
        {
            i3_frame(c.out, type, payload);
            i3_flush(c);
        }

        static uint32_t i3_event_bit(const std::string &name)
        {
            static const char *names[] = { "workspace", "output", "mode", "window", "barconfig_update", "binding", "shutdown", "tick" };
            for (uint32_t i = 0; i < 8; i++)
                if (name == names[i])
                    return 1u << i;
            return 0;
        }

        // Wyciaga napisy z tablicy JSON ["a","b"] (bez znakow ucieczki: nazwy zdarzen ich nie maja).
        static std::vector<std::string> i3_json_strings(const std::string &s)
        {
            std::vector<std::string> out;
            size_t i = 0;
            while ((i = s.find('"', i)) != std::string::npos)
            {
                const size_t j = s.find('"', i + 1);
                if (j == std::string::npos)
                    break;
                out.push_back(s.substr(i + 1, j - i - 1));
                i = j + 1;
            }
            return out;
        }

        static void i3_handle(I3Client &c, uint32_t type, const std::string &payload)
        {
            switch (type)
            {
            case 0: case 1: case 3: case 4:
            {
                if (g_i3_queue.size() < 256)
                    g_i3_queue.push_back(I3Req { c.id, type, payload });
                else
                    i3_send(c, type, "{\"success\":false,\"error\":\"za duzo oczekujacych zadan\"}");
                return;
            }
            case 2:
            {
                if (payload.find('[') == std::string::npos)
                {
                    i3_send(c, type, "{\"success\":false}");
                    return;
                }
                uint32_t bits = 0;
                for (const std::string &n : i3_json_strings(payload))
                    bits |= i3_event_bit(n);
                c.subs |= bits;
                i3_send(c, type, "{\"success\":true}");
                return;
            }
            case 5: i3_send(c, type, "[]"); return;
            case 6: i3_send(c, type, "[]"); return;
            case 7: i3_send(c, type, "{\"human_readable\":\"volcan 0.1.0\",\"variant\":\"i3\",\"major\":4,\"minor\":23,\"patch\":0,\"loaded_config_file_name\":\"\"}"); return;
            case 8: i3_send(c, type, "[\"default\"]"); return;
            case 9: i3_send(c, type, "{\"config\":\"\"}"); return;
            case 10:
            {
                i3_send(c, type, "{\"success\":true}");
                std::string ev = "{\"first\":false,\"payload\":\"";
                for (char ch : payload)
                {
                    if (ch == '"' || ch == '\\')
                        ev.push_back('\\');
                    if ((unsigned char)ch >= 0x20)
                        ev.push_back(ch);
                }
                ev += "\"}";
                for (I3Client &o : g_i3_clients)
                    if (!o.dead && (o.subs & (1u << 7)))
                        i3_send(o, 0x80000007u, ev);
                return;
            }
            case 11: i3_send(c, type, "{\"success\":true}"); return;
            case 12: i3_send(c, type, "{\"name\":\"default\"}"); return;
            case 100: i3_send(c, type, "[]"); return;
            case 101: i3_send(c, type, "[]"); return;
            default: i3_send(c, type, "{\"success\":false,\"error\":\"nieznany typ komunikatu\"}"); return;
            }
        }

        static void i3_parse(I3Client &c)
        {
            while (!c.dead && c.in.size() >= 14)
            {
                if (std::memcmp(c.in.data(), "i3-ipc", 6) != 0)
                {
                    c.dead = true;
                    return;
                }
                uint32_t len = 0, type = 0;
                std::memcpy(&len, c.in.data() + 6, 4);
                std::memcpy(&type, c.in.data() + 10, 4);
                if (len > (1u << 20))
                {
                    c.dead = true;
                    return;
                }
                if (c.in.size() < 14u + len)
                    return;
                const std::string payload = c.in.substr(14, len);
                c.in.erase(0, 14u + len);
                i3_handle(c, type, payload);
            }
        }

        // Tryb gniazda (np. 0600); wolac przed vcn_i3_listen_c.
        static int g_i3_mode = 0600;
        static void vcn_i3_set_mode(int64_t mode) { g_i3_mode = (int)(mode & 0777); }

        static int64_t vcn_i3_listen_c(const char *path)
        {
            if (g_i3_listen >= 0 || !path || !*path)
                return 0;
            sockaddr_un a {};
            a.sun_family = AF_UNIX;
            if (std::strlen(path) >= sizeof(a.sun_path))
                return 0;
            std::strncpy(a.sun_path, path, sizeof(a.sun_path) - 1);
            ::unlink(path);
            const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
            if (fd < 0)
                return 0;
            const mode_t old = ::umask(0177);
            const int rc = ::bind(fd, (sockaddr *)&a, sizeof(a));
            ::umask(old);
            if (rc != 0 || ::chmod(path, (mode_t)g_i3_mode) != 0 || ::listen(fd, 16) != 0)
            {
                ::close(fd);
                ::unlink(path);
                return 0;
            }
            g_i3_listen = fd;
            g_i3_path = path;
            return 1;
        }

        // Obsluguje nowe polaczenia i dane; zwraca 1, gdy czeka zadanie dla skryptu (typ i tresc: vcn_i3_type, vcn_i3_payload_c).
        static int64_t vcn_i3_poll(void)
        {
            if (g_i3_listen < 0)
                return 0;
            if (g_i3_have)
                return 1;
            for (;;)
            {
                const int fd = ::accept4(g_i3_listen, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
                if (fd < 0)
                    break;
                ucred cred {};
                socklen_t cl = sizeof(cred);
                if (::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &cl) != 0 || (cred.uid != ::getuid() && cred.uid != 0) || g_i3_clients.size() >= 32)
                {
                    g_i3_rejected++;
                    ::close(fd);
                    continue;
                }
                I3Client c;
                c.id = g_i3_next_id++;
                c.fd = fd;
                g_i3_clients.push_back(std::move(c));
            }
            for (I3Client &c : g_i3_clients)
            {
                if (c.dead)
                    continue;
                char buf[4096];
                for (;;)
                {
                    const ssize_t n = ::recv(c.fd, buf, sizeof(buf), MSG_DONTWAIT);
                    if (n > 0)
                    {
                        c.in.append(buf, (size_t)n);
                        if (c.in.size() > (2u << 20))
                        {
                            c.dead = true;
                            break;
                        }
                        continue;
                    }
                    if (n == 0)
                        c.dead = true;
                    else if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
                        c.dead = true;
                    break;
                }
                i3_parse(c);
                i3_flush(c);
            }
            for (size_t i = 0; i < g_i3_clients.size();)
            {
                if (g_i3_clients[i].dead)
                {
                    ::close(g_i3_clients[i].fd);
                    g_i3_clients.erase(g_i3_clients.begin() + (long)i);
                }
                else
                    i++;
            }
            while (!g_i3_queue.empty() && !g_i3_have)
            {
                g_i3_cur = g_i3_queue.front();
                g_i3_queue.pop_front();
                if (i3_find(g_i3_cur.cid))
                    g_i3_have = true;
            }
            return g_i3_have ? 1 : 0;
        }

        static int64_t vcn_i3_type(void) { return g_i3_have ? (int64_t)g_i3_cur.type : -1; }
        static const char *vcn_i3_payload_c(void) { return g_i3_have ? g_i3_cur.payload.c_str() : ""; }

        // Odpowiedz na biezace zadanie (ten sam typ co zadanie).
        static int64_t vcn_i3_reply_c(const char *json)
        {
            if (!g_i3_have)
                return 0;
            g_i3_have = false;
            I3Client *c = i3_find(g_i3_cur.cid);
            if (!c)
                return 0;
            i3_send(*c, g_i3_cur.type, json ? json : "{}");
            return 1;
        }

        // Zdarzenie dla subskrybentow: event 0 workspace, 1 output, 2 mode, 3 window, 4 barconfig_update, 5 binding, 6 shutdown, 7 tick.
        static int64_t vcn_i3_publish_c(int64_t event, const char *json)
        {
            if (event < 0 || event > 7)
                return 0;
            int64_t sent = 0;
            for (I3Client &c : g_i3_clients)
                if (!c.dead && (c.subs & (1u << event)))
                {
                    i3_send(c, 0x80000000u | (uint32_t)event, json ? json : "{}");
                    sent++;
                }
            return sent;
        }

        static int64_t vcn_i3_clients(void) { return (int64_t)g_i3_clients.size(); }
        static int64_t vcn_i3_stat_rejected(void) { return g_i3_rejected; }

        static void vcn_i3_close(void)
        {
            for (I3Client &c : g_i3_clients)
                ::close(c.fd);
            g_i3_clients.clear();
            g_i3_queue.clear();
            g_i3_have = false;
            if (g_i3_listen >= 0)
            {
                ::close(g_i3_listen);
                ::unlink(g_i3_path.c_str());
            }
            g_i3_listen = -1;
        }
        // END-I3IPC

        // Warstwa dla HackerScript (bufory jak w IPC: g_buf0 wejscie, g_buf1 wyjscie).
        int64_t vcn_i3_listen(void) { return vcn_i3_listen_c(g_buf0.c_str()); }
        int64_t vcn_i3_payload(void) { g_buf1 = vcn_i3_payload_c(); return (int64_t)g_buf1.size(); }
        int64_t vcn_i3_reply(void) { return vcn_i3_reply_c(g_buf0.c_str()); }
        int64_t vcn_i3_publish(int64_t event) { return vcn_i3_publish_c(event, g_buf0.c_str()); }
        void vcn_i3_chmod(int64_t mode) { vcn_i3_set_mode(mode); }
        int64_t vcn_i3_poll_c(void) { return vcn_i3_poll(); }
        int64_t vcn_i3_type_c(void) { return vcn_i3_type(); }
        int64_t vcn_i3_client_count(void) { return vcn_i3_clients(); }
        void vcn_i3_shutdown(void) { vcn_i3_close(); }

        // Wolane z vcn_dispatch: krok animacji (zdarzenie 98) i odbior zakonczonych procesow (zdarzenie 97: a = pid, b = status).
        static void vcn_pump_hooks(void)
        {
            vcn_anim_tick();
            int64_t pid = 0, st = 0;
            while (vcn_process_reap(&pid, &st) == 1)
                push(97, pid, st);
        }
        }

        extern "C" void volcan_shim_tail_unused()
        {
    ]
    end 1
]
