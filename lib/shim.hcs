        #include <signal.h>
        #include <mutex>
        #include <thread>
        #include <deque>
        #include <sys/socket.h>
        #include <sys/un.h>
        #include <fcntl.h>
        #include <poll.h>
        #include <errno.h>
        #include <cstring>
        #include <cstdio>
        #include <map>
        #include <chrono>
        #include <algorithm>
        #include <xkbcommon/xkbcommon.h>
        #include <xkbcommon/xkbcommon-names.h>
        #include <sys/inotify.h>
        #include <libinput.h>
        #include <CZ/Louvre/Protocols/ImageCaptureSource/RImageCaptureSource.h>
        #include <CZ/Louvre/Protocols/Wayland/GOutput.h>
        #include <drm_fourcc.h>
        #include <wayland-server-core.h>
        #include <wayland-server-protocol.h>
        #include <time.h>
        #include <CZ/Louvre/Roles/LPopupRole.h>
        #include <CZ/Louvre/Roles/LLayerRole.h>
        #include <CZ/Louvre/Roles/LSubsurfaceRole.h>
        #include <CZ/Louvre/Roles/LDNDIconRole.h>
        #include <CZ/Louvre/Roles/LSessionLockRole.h>
        #include <CZ/Louvre/Seat/LTouch.h>
        #include <CZ/Louvre/Seat/LClipboard.h>
        #include <CZ/Louvre/Seat/LDND.h>
        #include <CZ/Louvre/Manager/LSessionLockManager.h>
        #include <CZ/Core/Events/CZTouchDownEvent.h>
        #include <CZ/Core/Events/CZTouchMoveEvent.h>
        #include <CZ/Core/Events/CZTouchUpEvent.h>
        #include <CZ/Core/Events/CZTouchFrameEvent.h>
        #include <CZ/Core/Events/CZTouchCancelEvent.h>
        #include <CZ/Core/Events/CZPointerSwipeBeginEvent.h>
        #include <CZ/Core/Events/CZPointerSwipeUpdateEvent.h>
        #include <CZ/Core/Events/CZPointerSwipeEndEvent.h>
        #include <CZ/Core/Events/CZPointerPinchBeginEvent.h>
        #include <CZ/Core/Events/CZPointerPinchUpdateEvent.h>
        #include <CZ/Core/Events/CZPointerPinchEndEvent.h>
        #include <CZ/Core/Events/CZPointerHoldBeginEvent.h>
        #include <CZ/Core/Events/CZPointerHoldEndEvent.h>
        #include <CZ/Ream/RSurface.h>
        #include <CZ/Ream/RPass.h>
        #include <CZ/Ream/RPainter.h>
        #include <CZ/Ream/RGammaLUT.h>
        #include <CZ/Ream/RCore.h>
        #include <CZ/Ream/RDevice.h>
        #include <CZ/Louvre/Cursor/LCursorSource.h>
        #include <CZ/Louvre/Cursor/LCursor.h>
        #include <CZ/skia/core/SkCanvas.h>
        #include <CZ/skia/core/SkPaint.h>
        #include <CZ/skia/core/SkImage.h>
        #include <CZ/skia/core/SkRRect.h>
        #include <CZ/skia/core/SkFont.h>
        #include <CZ/skia/core/SkFontMgr.h>
        #include <CZ/skia/core/SkTypeface.h>
        #include <CZ/skia/core/SkMaskFilter.h>
        #include <CZ/skia/core/SkBlurTypes.h>
        #include <CZ/Louvre/Cursor/LShapeCursorSource.h>
        #include <CZ/Louvre/Cursor/LImageCursorSource.h>
        #include <CZ/skia/ports/SkFontMgr_fontconfig.h>
        #include <drm_fourcc.h>
        #include <cmath>
        }

        using namespace CZ;

        namespace
        {
        struct Ev
        {
            int64_t kind;
            int64_t a;
            int64_t b;
            double x;
            double y;
            int64_t c;
            std::string s;
        };

        std::deque<Ev> g_queue;
        Ev g_cur { 0, 0, 0, 0.0, 0.0, 0, std::string() };
        int64_t g_dropped = 0;
        std::string g_last_error;
        bool g_manual { false };
        std::string g_buf0;
        std::string g_buf1;

        void push(int64_t kind, int64_t a = 0, int64_t b = 0, double x = 0.0, double y = 0.0, int64_t c = 0, const std::string &text = std::string())
        {
            if (g_queue.size() >= 8192)
            {
                g_queue.pop_front();
                g_dropped++;
            }
            g_queue.push_back(Ev { kind, a, b, x, y, c, text });
        }

        int64_t H(const void *p)
        {
            return (int64_t)(intptr_t)p;
        }


        // ---- kontrakt jednowatkowy i kody bledow ----
        // Kazda funkcja vcn_* dotykajaca Louvre musi byc wolana z jednego watku ("wlasciciela"):
        // tego, ktory pierwszy wywolal taka funkcje (zwykle vcn_init). Inny watek dostaje wartosc
        // domyslna, kod VCN_E_THREAD i zwiekszony licznik naruszen - zamiast wyscigu danych.
        enum VcnCode
        {
            VCN_OK = 0,
            VCN_E_THREAD = 1,
            VCN_E_HANDLE = 2,
            VCN_E_STATE = 3,
            VCN_E_ARG = 4,
            VCN_E_UNSUPPORTED = 5,
            VCN_E_IO = 6,
            VCN_E_DENIED = 7
        };

        int64_t g_code = 0;
        int64_t g_thread_violations = 0;
        std::thread::id g_owner;
        bool g_owner_set = false;

        void set_error(int64_t code, const char *msg)
        {
            g_code = code;
            g_last_error = msg;
        }

        bool thread_ok()
        {
            const std::thread::id me = std::this_thread::get_id();
            if (!g_owner_set)
            {
                g_owner = me;
                g_owner_set = true;
                return true;
            }
            if (me == g_owner)
                return true;
            g_thread_violations++;
            g_code = VCN_E_THREAD;
            g_last_error = "wywolanie vcn_* z innego watku niz wlasciciel (patrz vcn_thread_adopt)";
            return false;
        }

        // ---- stan: styl rysowania, nakladki, polityki ----
        struct OverlayRect
        {
            int64_t x, y, w, h;
            uint32_t argb;
            int64_t group;
        };

        struct OverlayText
        {
            int64_t x, y, size;
            uint32_t argb;
            std::string text;
            int64_t group;
        };

        // Dekoracje po stronie serwera: tryb 0 brak, 1 wszystkie toplevele, 2 tylko gdy klient przyjal SSD.
        struct Deco
        {
            int64_t mode { 0 };
            int64_t bar_h { 28 };
            int64_t font_px { 14 };
            uint32_t bg_active { 0xFF2B2F3A };
            uint32_t bg_inactive { 0xFF1E2028 };
            uint32_t fg_active { 0xFFE6E6E6 };
            uint32_t fg_inactive { 0xFF8A8F9B };
            int64_t btn_size { 14 };
            int64_t btn_gap { 8 };
            uint32_t btn_close { 0xFFE5534B };
            uint32_t btn_max { 0xFF4CAF50 };
            uint32_t btn_min { 0xFFE5B80B };
            std::string font_family { "sans-serif" };
        };

        struct Style
        {
            bool enabled { false };
            uint32_t background { 0xFF00356B };
            int64_t border { 0 };
            uint32_t border_active { 0xFF4C9AFF };
            uint32_t border_inactive { 0xFF333333 };
            int64_t radius { 0 };
            int64_t shadow_radius { 0 };
            int64_t shadow_dx { 0 };
            int64_t shadow_dy { 6 };
            uint32_t shadow_color { 0x80000000 };
            Deco deco;
            std::shared_ptr<RImage> wall_image;
            int64_t wall_mode { 1 };
            std::vector<OverlayRect> overlays;
            std::vector<OverlayText> texts;
        };

        Style g_style;

        // Stan rysowania pojedynczego okna (krycie, skala, wlasny kolor ramki) - klucz: uchwyt powierzchni.
        struct WinState
        {
            double alpha { 1.0 };
            double scale { 1.0 };
            bool has_border { false };
            uint32_t border { 0 };
        };

        std::map<int64_t, WinState> g_win;
        std::map<int64_t, int64_t> g_mirror;   // wyjscie docelowe -> zrodlowe
        std::map<int64_t, bool> g_blank;       // wyjscia wygaszone

        // Animacje: rodzaj 0 pozycja, 1 krycie, 2 skala.
        struct Anim
        {
            int64_t h;
            int kind;
            double x0, y0, x1, y1;
            std::chrono::steady_clock::time_point t0;
            int64_t dur;
            int ease;
        };

        std::vector<Anim> g_anims;
        bool g_clip_allow { true };
        bool g_lock_allow { true };

        // ---- podklasy fabryczne: tylko doklejaja zdarzenia, zachowanie bazowe zostaje ----

        // Konfiguracja libinput (blok konfiguracji libinput nizej): deklaracja wyprzedzajaca i dostep do uchwytu urzadzenia.
        static int li_apply_all(libinput_device *d);

        static libinput_device *li_handle(const std::shared_ptr<CZInputDevice> &dev)
        {
            if (!dev || dev->nativeHandleType != CZInputDevice::NativeHandleType::Libinput)
                return nullptr;
            return dev->nativeHandle.libinput;
        }

        class VSurface : public LSurface
        {
        public:
            VSurface(const void *params) noexcept : LSurface(params)
            {
                push(1, H(this));
            }

            void mappingChanged() override
            {
                LSurface::mappingChanged();
                push(mapped() ? 3 : 4, H(this));
            }

            void roleChanged() noexcept override
            {
                LSurface::roleChanged();
                push(50, H(this), (int64_t)roleId());
            }

            // Klient zmienil tryb ograniczenia wskaznika (0 swobodny, 1 lock, 2 confine).
            // Wlaczeniem ograniczenia zajmuje sie bazowy LPointer (domyslnie wlacza je, gdy kursor
            // jest w regionie), skrypt dostaje tylko informacje, np. do ukrycia kursora w grze.
            void pointerConstraintModeChanged() override
            {
                LSurface::pointerConstraintModeChanged();
                push(100, H(this), (int64_t)pointerConstraintMode());
            }
        };

        class VToplevel : public LToplevelRole
        {
        public:
            VToplevel(const void *params) noexcept : LToplevelRole(params) {}

            int64_t sh() const
            {
                return H(surface());
            }

            void titleChanged() override
            {
                LToplevelRole::titleChanged();
                push(5, sh());
            }

            void appIdChanged() override
            {
                LToplevelRole::appIdChanged();
                push(6, sh());
            }

            void startMoveRequest(const CZEvent &e) override
            {
                if (!g_manual)
                    LToplevelRole::startMoveRequest(e);
                push(7, sh());
            }

            void startResizeRequest(const CZEvent &e, CZBitset<CZEdge> edge) override
            {
                if (!g_manual)
                    LToplevelRole::startResizeRequest(e, edge);
                int64_t mask = 0;
                if (edge.has(CZEdgeTop))
                    mask |= 1;
                if (edge.has(CZEdgeBottom))
                    mask |= 2;
                if (edge.has(CZEdgeLeft))
                    mask |= 4;
                if (edge.has(CZEdgeRight))
                    mask |= 8;
                push(8, sh(), mask);
            }

            void setMaximizedRequest() override
            {
                if (!g_manual)
                    LToplevelRole::setMaximizedRequest();
                push(9, sh());
            }

            void unsetMaximizedRequest() override
            {
                if (!g_manual)
                    LToplevelRole::unsetMaximizedRequest();
                push(10, sh());
            }

            void setFullscreenRequest(LOutput *dest) override
            {
                if (!g_manual)
                    LToplevelRole::setFullscreenRequest(dest);
                push(11, sh(), H(dest));
            }

            void unsetFullscreenRequest() override
            {
                if (!g_manual)
                    LToplevelRole::unsetFullscreenRequest();
                push(12, sh());
            }

            void setMinimizedRequest() override
            {
                if (!g_manual)
                    LToplevelRole::setMinimizedRequest();
                push(13, sh());
            }

            void unsetMinimizedRequest() override
            {
                if (!g_manual)
                    LToplevelRole::unsetMinimizedRequest();
                push(14, sh());
            }

            void closeRequest() override
            {
                if (!g_manual)
                    LToplevelRole::closeRequest();
                push(15, sh());
            }

            void activateRequest() override
            {
                if (!g_manual)
                    LToplevelRole::activateRequest();
                push(16, sh());
            }
        };

        static void vcn_sc_output_removed(int64_t out);
        static void vcn_sc_output_painted(int64_t out);

        class VSeat : public LSeat
        {
        public:
            VSeat(const void *params) noexcept : LSeat(params) {}

            void outputPlugged(LOutput *output) override
            {
                LSeat::outputPlugged(output);
                push(20, H(output));
            }

            void outputUnplugged(LOutput *output) override
            {
                vcn_sc_output_removed(H(output));
                push(21, H(output));
                LSeat::outputUnplugged(output);
            }

            // Nowe urzadzenie dostaje od razu skonfigurowane reguly libinput; skrypt dostaje zdarzenie z nazwa.
            void inputDevicePlugged(std::shared_ptr<CZInputDevice> dev) override
            {
                LSeat::inputDevicePlugged(dev);
                libinput_device *d = li_handle(dev);
                if (d)
                    li_apply_all(d);
                push(101, 0, 0, 0.0, 0.0, dev ? (int64_t)dev->caps.get() : 0, dev ? dev->name : std::string());
            }

            void inputDeviceUnplugged(std::shared_ptr<CZInputDevice> dev) override
            {
                push(102, 0, 0, 0.0, 0.0, 0, dev ? dev->name : std::string());
                LSeat::inputDeviceUnplugged(dev);
            }

            void activeToplevelChanged(LToplevelRole *prev) noexcept override
            {
                LSeat::activeToplevelChanged(prev);
                LToplevelRole *t = activeToplevel();
                push(40, t ? H(t->surface()) : 0);
            }
        };

        class VPointer : public LPointer
        {
        public:
            VPointer(const void *params) noexcept : LPointer(params) {}

            void pointerMoveEvent(const CZPointerMoveEvent &e) override
            {
                push(30, 0, 0, (double)e.delta.x(), (double)e.delta.y());
                LPointer::pointerMoveEvent(e);
            }

            void pointerButtonEvent(const CZPointerButtonEvent &e) override
            {
                push(31, (int64_t)e.button, e.pressed ? 1 : 0);
                LPointer::pointerButtonEvent(e);
            }

            void pointerScrollEvent(const CZPointerScrollEvent &e) override
            {
                push(33, (int64_t)e.source, (int64_t)e.axesDiscrete.x(), (double)e.axes.x(), (double)e.axes.y(), (int64_t)e.axesDiscrete.y());
                LPointer::pointerScrollEvent(e);
            }

            void pointerSwipeBeginEvent(const CZPointerSwipeBeginEvent &e) override
            {
                push(80);
                LPointer::pointerSwipeBeginEvent(e);
            }

            void pointerSwipeUpdateEvent(const CZPointerSwipeUpdateEvent &e) override
            {
                push(81, 0, 0, (double)e.delta.x(), (double)e.delta.y());
                LPointer::pointerSwipeUpdateEvent(e);
            }

            void pointerSwipeEndEvent(const CZPointerSwipeEndEvent &e) override
            {
                push(82, e.cancelled ? 1 : 0);
                LPointer::pointerSwipeEndEvent(e);
            }

            void pointerPinchBeginEvent(const CZPointerPinchBeginEvent &e) override
            {
                push(83);
                LPointer::pointerPinchBeginEvent(e);
            }

            void pointerPinchUpdateEvent(const CZPointerPinchUpdateEvent &e) override
            {
                push(84, 0, 0, (double)e.delta.x(), (double)e.delta.y());
                LPointer::pointerPinchUpdateEvent(e);
            }

            void pointerPinchEndEvent(const CZPointerPinchEndEvent &e) override
            {
                push(85, e.cancelled ? 1 : 0);
                LPointer::pointerPinchEndEvent(e);
            }

            void pointerHoldBeginEvent(const CZPointerHoldBeginEvent &e) override
            {
                push(86);
                LPointer::pointerHoldBeginEvent(e);
            }

            void pointerHoldEndEvent(const CZPointerHoldEndEvent &e) override
            {
                push(87, e.cancelled ? 1 : 0);
                LPointer::pointerHoldEndEvent(e);
            }
        };

        class VKeyboard : public LKeyboard
        {
        public:
            VKeyboard(const void *params) noexcept : LKeyboard(params) {}

            void keyEvent(const CZKeyboardKeyEvent &e) override
            {
                push(32, (int64_t)e.code, e.isPressed ? 1 : 0, 0.0, 0.0, (int64_t)e.symbol, e.isPressed ? std::string(e.utf8) : std::string());
                LKeyboard::keyEvent(e);
            }
        };

        class VPopup : public LPopupRole
        {
        public:
            VPopup(const void *params) noexcept : LPopupRole(params) {}

            void configureRequest() override
            {
                if (!g_manual)
                    LPopupRole::configureRequest();
                push(17, H(surface()));
            }

            void grabKeyboardRequest(const CZEvent &e) override
            {
                if (!g_manual)
                    LPopupRole::grabKeyboardRequest(e);
                push(18, H(surface()));
            }
        };

        class VLayer : public LLayerRole
        {
        public:
            VLayer(const void *params) noexcept : LLayerRole(params) {}

            void stateChanged(CZBitset<Changes> changes, const State &prev) noexcept override
            {
                LLayerRole::stateChanged(changes, prev);
                push(51, H(surface()));
            }
        };

        class VTouch : public LTouch
        {
        public:
            VTouch(const void *params) noexcept : LTouch(params) {}

            void touchDownEvent(const CZTouchDownEvent &e) override
            {
                push(70, (int64_t)LTouch::GetTouchEventId(e), 0, (double)e.pos.x(), (double)e.pos.y());
                LTouch::touchDownEvent(e);
            }

            void touchMoveEvent(const CZTouchMoveEvent &e) override
            {
                push(71, (int64_t)LTouch::GetTouchEventId(e), 0, (double)e.pos.x(), (double)e.pos.y());
                LTouch::touchMoveEvent(e);
            }

            void touchUpEvent(const CZTouchUpEvent &e) override
            {
                push(72, (int64_t)LTouch::GetTouchEventId(e));
                LTouch::touchUpEvent(e);
            }

            void touchFrameEvent(const CZTouchFrameEvent &e) override
            {
                push(73);
                LTouch::touchFrameEvent(e);
            }

            void touchCancelEvent(const CZTouchCancelEvent &e) override
            {
                push(74);
                LTouch::touchCancelEvent(e);
            }
        };

        class VClipboard : public LClipboard
        {
        public:
            VClipboard(const void *params) noexcept : LClipboard(params) {}

            bool setClipboardRequest(LClient *client, const CZEvent &e) override
            {
                push(90, H(client));
                if (!g_clip_allow)
                    return false;
                return LClipboard::setClipboardRequest(client, e);
            }
        };

        class VDND : public LDND
        {
        public:
            VDND(const void *params) noexcept : LDND(params) {}

            void startDragRequest() override
            {
                push(91);
                LDND::startDragRequest();
            }

            void cancelled() override
            {
                push(92);
                LDND::cancelled();
            }

            void dropped() override
            {
                push(93);
                LDND::dropped();
            }
        };

        class VSessionLock : public LSessionLockManager
        {
        public:
            VSessionLock(const void *params) noexcept : LSessionLockManager(params) {}

            bool lockRequest(LClient *client) override
            {
                push(95, H(client));
                if (!g_lock_allow)
                    return false;
                return LSessionLockManager::lockRequest(client);
            }

            void stateChanged() override
            {
                LSessionLockManager::stateChanged();
                push(96, (int64_t)state());
            }
        };

        // ---- wlasne rysowanie przez SkCanvas (wlaczane przez vcn_style_enable) ----
        // Tlo/tapeta, cienie, zaokraglone rogi, ramki, paski tytulowe z tekstem, nakladki, animacje.
        // Wspolrzedne sa globalne (geometria przejscia mapuje viewport wyjscia na jego obraz).
        sk_sp<SkTypeface> v_typeface()
        {
            static sk_sp<SkFontMgr> mgr;
            static sk_sp<SkTypeface> tf;
            static std::string family;
            if (!mgr)
                mgr = SkFontMgr_New_FontConfig(nullptr);
            if (!tf || family != g_style.deco.font_family)
            {
                family = g_style.deco.font_family;
                if (mgr)
                {
                    tf = mgr->matchFamilyStyle(family.c_str(), SkFontStyle::Normal());
                    if (!tf)
                        tf = mgr->matchFamilyStyle(nullptr, SkFontStyle::Normal());
                }
            }
            return tf;
        }

        void v_text(SkCanvas *c, const std::string &text, SkScalar x, SkScalar y, int64_t px, uint32_t argb, double alpha)
        {
            sk_sp<SkTypeface> tf = v_typeface();
            if (!tf || text.empty())
                return;
            SkFont font(tf, (SkScalar)px);
            font.setSubpixel(true);
            SkPaint p;
            p.setAntiAlias(true);
            p.setColor((SkColor)argb);
            p.setAlphaf(p.getAlphaf() * (float)alpha);
            c->drawString(text.c_str(), x, y, font, p);
        }

        SkIRect v_window_rect(LSurface *s)
        {
            const SkIPoint pos = s->rolePos();
            if (LToplevelRole *t = s->toplevel())
            {
                const SkIRect g = t->windowGeometry();
                return SkIRect::MakeXYWH(pos.x() + g.x(), pos.y() + g.y(), g.width(), g.height());
            }
            return SkIRect::MakePtSize(pos, s->size());
        }

        // Geometria paska tytulowego i przyciskow okna; false, gdy okno nie jest dekorowane.
        struct DecoGeom
        {
            SkIRect body, bar, close, maxi, mini;
        };

        bool deco_geom(LSurface *s, DecoGeom &g)
        {
            LToplevelRole *t = s->toplevel();
            if (!t || g_style.deco.mode == 0 || !s->mapped() || t->isFullscreen() || t->isMinimized())
                return false;
            if (g_style.deco.mode == 2 && t->decorationMode() != LToplevelRole::ServerSide)
                return false;
            g.body = v_window_rect(s);
            const int32_t bh = (int32_t)g_style.deco.bar_h;
            g.bar = SkIRect::MakeXYWH(g.body.x(), g.body.y() - bh, g.body.width(), bh);
            const int32_t sz = (int32_t)g_style.deco.btn_size;
            const int32_t gap = (int32_t)g_style.deco.btn_gap;
            const int32_t y = g.bar.y() + (bh - sz) / 2;
            int32_t x = g.bar.right() - gap - sz;
            g.close = SkIRect::MakeXYWH(x, y, sz, sz);
            x -= gap + sz;
            g.maxi = SkIRect::MakeXYWH(x, y, sz, sz);
            x -= gap + sz;
            g.mini = SkIRect::MakeXYWH(x, y, sz, sz);
            return true;
        }

        WinState *win_state(LSurface *s)
        {
            auto it = g_win.find(H(s));
            return it == g_win.end() ? nullptr : &it->second;
        }

        void v_clip_rrect(SkRRect &rr, const SkRect &r, double rad, bool top_round)
        {
            const SkScalar k = (SkScalar)rad;
            const SkVector radii[4] = { { top_round ? k : 0, top_round ? k : 0 }, { top_round ? k : 0, top_round ? k : 0 }, { k, k }, { k, k } };
            rr.setRectRadii(r, radii);
        }

        void v_draw_surface(SkCanvas *c, LSurface *s, double alpha)
        {
            for (LOutput *o : compositor()->outputs())
            {
                if (SkIRect::Intersects(o->rect(), SkIRect::MakePtSize(s->rolePos(), s->size())))
                    s->sendOutputEnterEvent(o);
                else
                    s->sendOutputLeaveEvent(o);
            }
            sk_sp<SkImage> img = s->image() ? s->image()->skImage() : nullptr;
            if (img)
            {
                const SkRect dst = SkRect::Make(SkIRect::MakePtSize(s->rolePos(), s->size()));
                SkRect src = s->srcRect();
                const SkScalar sc = (SkScalar)s->scale();
                src = SkRect::MakeLTRB(src.left() * sc, src.top() * sc, src.right() * sc, src.bottom() * sc);
                SkPaint p;
                p.setAntiAlias(true);
                p.setAlphaf((float)alpha);
                c->drawImageRect(img, src, dst, SkSamplingOptions(SkFilterMode::kLinear), &p, SkCanvas::kFast_SrcRectConstraint);
            }
            s->requestNextFrame();
        }

        void v_draw_subsurfaces(SkCanvas *c, const std::vector<LSubsurfaceRole *> &subs, double alpha)
        {
            for (auto *sub : subs)
            {
                if (!sub->surface()->mapped())
                    continue;
                v_draw_subsurfaces(c, sub->surface()->subsurfacesBelow(), alpha);
                v_draw_surface(c, sub->surface(), alpha);
                v_draw_subsurfaces(c, sub->surface()->subsurfacesAbove(), alpha);
            }
        }

        // Cien, pasek tytulowy (z tekstem i przyciskami) i ramka toplevela.
        void v_draw_decorations(SkCanvas *c, LSurface *s, LToplevelRole *t, double alpha)
        {
            DecoGeom g {};
            const bool decorated = deco_geom(s, g);
            SkIRect full = decorated ? SkIRect::MakeLTRB(g.bar.left(), g.bar.top(), g.body.right(), g.body.bottom()) : v_window_rect(s);
            const bool active = compositor()->seat()->activeToplevel() == t;
            const double rad = (double)g_style.radius;
            SkRRect frame;
            v_clip_rrect(frame, SkRect::Make(full), rad, true);

            if (g_style.shadow_radius > 0)
            {
                SkPaint sp;
                sp.setAntiAlias(true);
                sp.setColor((SkColor)g_style.shadow_color);
                sp.setAlphaf(sp.getAlphaf() * (float)alpha);
                sp.setMaskFilter(SkMaskFilter::MakeBlur(kNormal_SkBlurStyle, (SkScalar)g_style.shadow_radius / 2.f));
                SkRRect shadow;
                v_clip_rrect(shadow, SkRect::Make(full).makeOffset((SkScalar)g_style.shadow_dx, (SkScalar)g_style.shadow_dy), rad, true);
                c->drawRRect(shadow, sp);
            }

            if (decorated)
            {
                SkPaint bp;
                bp.setAntiAlias(true);
                bp.setColor((SkColor)(active ? g_style.deco.bg_active : g_style.deco.bg_inactive));
                bp.setAlphaf(bp.getAlphaf() * (float)alpha);
                SkRRect bar;
                v_clip_rrect(bar, SkRect::Make(g.bar), rad, true);
                const SkVector flat[4] = { { (SkScalar)rad, (SkScalar)rad }, { (SkScalar)rad, (SkScalar)rad }, { 0, 0 }, { 0, 0 } };
                bar.setRectRadii(SkRect::Make(g.bar), flat);
                c->drawRRect(bar, bp);

                const int64_t px = g_style.deco.font_px;
                c->save();
                c->clipRect(SkRect::MakeLTRB((SkScalar)g.bar.left() + 8, (SkScalar)g.bar.top(), (SkScalar)g.mini.left() - 8, (SkScalar)g.bar.bottom()));
                v_text(c, std::string(t->title()), (SkScalar)g.bar.left() + 12, (SkScalar)g.bar.top() + (SkScalar)(g_style.deco.bar_h + px) / 2.f - 2.f, px,
                       active ? g_style.deco.fg_active : g_style.deco.fg_inactive, alpha);
                c->restore();

                const struct { SkIRect r; uint32_t col; } btn[3] = { { g.close, g_style.deco.btn_close }, { g.maxi, g_style.deco.btn_max }, { g.mini, g_style.deco.btn_min } };
                for (const auto &b : btn)
                {
                    SkPaint cp;
                    cp.setAntiAlias(true);
                    cp.setColor((SkColor)b.col);
                    cp.setAlphaf(cp.getAlphaf() * (float)alpha * (active ? 1.f : 0.55f));
                    c->drawCircle((SkScalar)(b.r.left() + b.r.right()) / 2.f, (SkScalar)(b.r.top() + b.r.bottom()) / 2.f, (SkScalar)b.r.width() / 2.f, cp);
                }
            }

            if (g_style.border > 0)
            {
                WinState *ws = win_state(s);
                SkPaint op;
                op.setAntiAlias(true);
                op.setStyle(SkPaint::kStroke_Style);
                op.setStrokeWidth((SkScalar)g_style.border);
                op.setColor((SkColor)((ws && ws->has_border) ? ws->border : (active ? g_style.border_active : g_style.border_inactive)));
                op.setAlphaf(op.getAlphaf() * (float)alpha);
                SkRRect outline;
                v_clip_rrect(outline, SkRect::Make(full).makeOutset((SkScalar)g_style.border / 2.f, (SkScalar)g_style.border / 2.f), rad + (double)g_style.border / 2.0, true);
                c->drawRRect(outline, op);
            }
        }

        void v_draw_tree(SkCanvas *c, LSurface *s)
        {
            if (!s->mapped() || (s->toplevel() && s->toplevel()->isMinimized()))
                return;

            LToplevelRole *t = s->toplevel();
            WinState *ws = win_state(s);
            const double alpha = ws ? ws->alpha : 1.0;
            const double scale = ws ? ws->scale : 1.0;

            c->save();
            if (t && scale > 0.01 && std::abs(scale - 1.0) > 0.001)
            {
                const SkIRect r = v_window_rect(s);
                const SkScalar cx = (SkScalar)(r.left() + r.right()) / 2.f, cy = (SkScalar)(r.top() + r.bottom()) / 2.f;
                c->translate(cx, cy);
                c->scale((SkScalar)scale, (SkScalar)scale);
                c->translate(-cx, -cy);
            }

            if (t)
                v_draw_decorations(c, s, t, alpha);

            if (t && g_style.radius > 0)
            {
                DecoGeom g {};
                const bool decorated = deco_geom(s, g);
                SkRRect body;
                v_clip_rrect(body, SkRect::Make(v_window_rect(s)), (double)g_style.radius, !decorated);
                const SkVector bottom[4] = { { 0, 0 }, { 0, 0 }, { (SkScalar)g_style.radius, (SkScalar)g_style.radius }, { (SkScalar)g_style.radius, (SkScalar)g_style.radius } };
                if (decorated)
                    body.setRectRadii(SkRect::Make(v_window_rect(s)), bottom);
                c->save();
                c->clipRRect(body, true);
                v_draw_subsurfaces(c, s->subsurfacesBelow(), alpha);
                v_draw_surface(c, s, alpha);
                v_draw_subsurfaces(c, s->subsurfacesAbove(), alpha);
                c->restore();
            }
            else
            {
                v_draw_subsurfaces(c, s->subsurfacesBelow(), alpha);
                v_draw_surface(c, s, alpha);
                v_draw_subsurfaces(c, s->subsurfacesAbove(), alpha);
            }
            c->restore();

            if (t)
            {
                for (auto *child : t->childPopups())
                    v_draw_tree(c, child->surface());
                for (auto *child : t->childToplevels())
                    v_draw_tree(c, child->surface());
            }
            else if (auto *popup = s->popup())
            {
                for (auto *child : popup->childPopups())
                    v_draw_tree(c, child->surface());
            }
            else if (auto *layerRole = s->layerRole())
            {
                for (auto *child : layerRole->childPopups())
                    v_draw_tree(c, child->surface());
            }
        }

        void v_draw_wallpaper(SkCanvas *c, const SkRect &out)
        {
            if (!g_style.wall_image)
                return;
            sk_sp<SkImage> img = g_style.wall_image->skImage();
            if (!img)
                return;
            const SkScalar iw = (SkScalar)img->width(), ih = (SkScalar)img->height();
            SkRect src = SkRect::MakeWH(iw, ih), dst = out;
            const SkScalar ar = out.width() / out.height(), ir = iw / ih;
            if (g_style.wall_mode == 1)          // wypelnij (przytnij)
            {
                if (ir > ar)
                {
                    const SkScalar w = ih * ar;
                    src = SkRect::MakeXYWH((iw - w) / 2.f, 0, w, ih);
                }
                else
                {
                    const SkScalar h = iw / ar;
                    src = SkRect::MakeXYWH(0, (ih - h) / 2.f, iw, h);
                }
            }
            else if (g_style.wall_mode == 2)     // dopasuj (pasy)
            {
                if (ir > ar)
                {
                    const SkScalar h = out.width() / ir;
                    dst = SkRect::MakeXYWH(out.left(), out.top() + (out.height() - h) / 2.f, out.width(), h);
                }
                else
                {
                    const SkScalar w = out.height() * ir;
                    dst = SkRect::MakeXYWH(out.left() + (out.width() - w) / 2.f, out.top(), w, out.height());
                }
            }
            else if (g_style.wall_mode == 3)     // srodek, bez skalowania
                dst = SkRect::MakeXYWH(out.left() + (out.width() - iw) / 2.f, out.top() + (out.height() - ih) / 2.f, iw, ih);
            SkPaint p;
            p.setAntiAlias(true);
            c->drawImageRect(img, src, dst, SkSamplingOptions(SkFilterMode::kLinear), &p, SkCanvas::kFast_SrcRectConstraint);
        }

