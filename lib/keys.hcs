const KEY_PAGEDOWN: Int = 109
const KEY_DELETE: Int = 111

!! Maski modyfikatorow (do mods_now / chord_is).
const MOD_SHIFT: Int = 1
const MOD_CTRL: Int = 2
const MOD_ALT: Int = 4
const MOD_SUPER: Int = 8

!! Aktualnie wcisniete modyfikatory jako suma masek MOD_*.
fun mods_now() -> Int [
    let m = 0
    if ffi_key_pressed(KEY_LEFTSHIFT) == 1 or ffi_key_pressed(KEY_RIGHTSHIFT) == 1 [
        m = m + MOD_SHIFT
    ]
    if ffi_key_pressed(KEY_LEFTCTRL) == 1 or ffi_key_pressed(KEY_RIGHTCTRL) == 1 [
        m = m + MOD_CTRL
    ]
    if ffi_key_pressed(KEY_LEFTALT) == 1 or ffi_key_pressed(KEY_RIGHTALT) == 1 [
        m = m + MOD_ALT
    ]
    if ffi_key_pressed(KEY_LEFTMETA) == 1 or ffi_key_pressed(KEY_RIGHTMETA) == 1 [
        m = m + MOD_SUPER
    ]
    end m
]

!! Czy dokladnie te modyfikatory (i zadne inne) sa teraz wcisniete.
fun chord_is(mods: Int) -> Bool [
    end mods_now() == mods
]

!! Modyfikatory ze stanu xkb (uwzglednia blokady i uklad): suma masek MOD_*.
fun mods_xkb() -> Int [
    end ffi_keyboard_mods()
]

!! Uklad klawiatury, np. keyboard_set_keymap("pl", "", "ctrl:nocaps"). Puste = domyslne.
fun keyboard_set_keymap(layout: Str, variant: Str, options: Str) -> Bool [
    ffi_buf_clear(0)
    text_push(0, layout + "\n" + variant + "\n" + options)
    end ffi_keyboard_set_keymap() == 1
]

fun keyboard_set_repeat(rate: Int, delay_ms: Int) [
    ffi_keyboard_set_repeat(rate, delay_ms)
    end
]

fun keyboard_repeat_rate() -> Int [
    end ffi_keyboard_repeat_rate()
]

fun keyboard_repeat_delay() -> Int [
    end ffi_keyboard_repeat_delay()
]

!! Wirtualna klawiatura: wstrzykuje zdarzenie klawisza do seata (jak fizyczny klawisz), np. dla
!! ekranowej klawiatury kompozytora albo polecenia IPC `key`. Louvre nie ma protokolow
!! virtual-keyboard ani text-input, wiec to dziala tylko wewnatrz kompozytora.
fun keyboard_send_key(code: Int, pressed: Bool) [
    if pressed [
        ffi_keyboard_send_key(code, 1)
    ] else [
        ffi_keyboard_send_key(code, 0)
    ]
    end
]

!! Nacisniecie i puszczenie klawisza.
fun keyboard_tap(code: Int) [
    ffi_keyboard_send_key(code, 1)
    ffi_keyboard_send_key(code, 0)
    end
]
