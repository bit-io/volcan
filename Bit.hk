[package]
-> name        => volcan
-> version     => 0.1.0
-> description => Wayland compositor library for HackerScript - bindings to Louvre (C++), inspired by smithay.
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => HackerScript

[layout]
-> lib => lib

[lib]
-> output => hlib

[build]
-> link => static

[default-build]
-> profile => release
